const threadLastReplyTime = new Map();
const COOLDOWN_DELAY = 2000; // 2 Seconds

function loadAllData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const content = fs.readFileSync(DATA_PATH, "utf8");
      return JSON.parse(content);
    }
  } catch (err) {
    console.error("[Data Load Error]:", err.message);
  }
  return {};
}

function saveAllData(data) {
  try {
    fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2), "utf8");
  } catch (err) {
    console.error("[Data Save Error]:", err.message);
  }
}

function getThreadData(threadID) {
  const allData = loadAllData();
  return allData[threadID] || { active: false, lockedGName: DEFAULT_LOCKED_NAME, lockedNick: DEFAULT_LOCKED_NAME };
}

function isThreadActive(threadID) {
  const threadData = getThreadData(threadID);
  return Boolean(threadData.active);
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

function checkIsAdmin(senderID) {
  return ADMIN_UIDS.includes(String(senderID));
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;

  if (!isThreadActive(threadID)) return;

  const threadData = getThreadData(threadID);
  const currentLockedGName = threadData.lockedGName || DEFAULT_LOCKED_NAME;
  const currentLockedNick = threadData.lockedNick || DEFAULT_LOCKED_NAME;

  // 1. AUTO SETGNAME LOCK (FOR THIS GC ONLY)
  if (logMessageType === "log:thread-name") {
    const newName = logMessageData ? logMessageData.name : "";
    if (newName !== currentLockedGName) {
      api.setTitle(currentLockedGName, threadID, (err) => {
        if (!err) {
          api.sendMessage(`🚫 WAG MO SUBUKANG PALITAN GC NAME! NAKA-LOCK KAY "${currentLockedGName}" ITO SA GC NA 'TO! 💀 💯 🤪`, threadID);
        }
      });
    }
    return;
  }

  // 2. AUTO SETNICK LOCK (FOR THIS GC ONLY)
  if (logMessageType === "log:user-nickname") {
    const changedUser = logMessageData ? logMessageData.participant_id : null;
    const newNick = logMessageData ? logMessageData.nickname : "";

    if (changedUser && newNick !== currentLockedNick) {
      await sleep(1000);
      api.changeNickname(currentLockedNick, threadID, changedUser, () => {});
    }
    return;
  }

  // Ignore bot's own messages and command invocations
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  // 3. 2 SECONDS AUTO REPLY COOLDOWN PER GC
  const now = Date.now();
  const lastThreadTime = threadLastReplyTime.get(threadID) || 0;

  if (now - lastThreadTime < COOLDOWN_DELAY) {
    return;
  }
  threadLastReplyTime.set(threadID, now);

  // 4. FIX FOR AUTO REACT (PROPER FCA REACTION CALL)
  const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
  try {
    api.setMessageReaction(randomEmoji, messageID, (err) => {
      if (err) console.error("[Reaction Error]:", err);
    }, true);
  } catch (e) {
    console.error("[Reaction Catch]:", e.message);
  }

  // 5. AUTO REPLY ROAST
  const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
  await sleep(1000);

  api.sendMessage({
    body: randomRoast,
    mentions: [{ tag: `@${senderID}`, id: senderID }]
  }, threadID, messageID);
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;

  // CHECK KUNG DALAWA SA INI-ALLOW NA ADMIN UIDs ANG SENDER
  if (!checkIsAdmin(senderID)) {
    const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
    return api.sendMessage(`🔥 SUBUKAN MO PA MAG-COMMAND KAHIT HINDI KA ADMIN? ETO SA'YO:\n\n${randomRoast}`, threadID, messageID);
  }

  const sub = (args[0] || "").toLowerCase();
  const allData = loadAllData();
  const threadData = getThreadData(threadID);

  // /ryukpogi on
  if (sub === "on") {
    threadData.active = true;
    threadData.activatedBy = senderID;
    threadData.activatedAt = Date.now();
    
    allData[threadID] = threadData;
    saveAllData(allData);

    return api.sendMessage(
      `🔥 RYUK POGI MODE IS NOW LIVE & DOMINATING THIS GC! 🔥\n\n` +
      `⚡ STATUS: LOCAL GC ACTIVE (WALANG MUKHANG SUSUKO, WALANG MATUTULOG)\n` +
      `👑 COMMANDER ID: ${senderID}\n` +
      `🔒 LOCKED GC NAME: "${threadData.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `🔒 LOCKED NICKNAME: "${threadData.lockedNick || DEFAULT_LOCKED_NAME}"\n` +
      `💥 AUTOMATIC REACTION & ROAST SYSTEM: 100% FULL SPEED 🤪 💯\n\n` +
      `SINO PIPALAG SA GC NA 'TO HAH? LAHAT NG MAG-CHAT DUDURUGIN AT AASARIN NA 24/7! 😈⚡`,
      threadID,
      messageID
    );
  }

  // /ryukpogi off
  if (sub === "off") {
    if (threadData.active) {
      threadData.active = false;
      allData[threadID] = threadData;
      saveAllData(allData);
      return api.sendMessage("❌ PINATAY MO ANG RYUK POGI MODE SA GC NA 'TO! TAHIMIK NA ULIT ANG MGA EPAL. 💤⚡", threadID, messageID);
    }
    return api.sendMessage("💀 HINDI PA MAN NAKASINDI ANG BOT SA GC NA 'TO BAGO MO PATAYIN, TULOG NGA MUNA SABI EH!", threadID, messageID);
  }

  // /ryukpogi setgname <name>
  if (sub === "setgname") {
    const newGName = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    threadData.lockedGName = newGName;
    allData[threadID] = threadData;
    saveAllData(allData);

    api.setTitle(newGName, threadID, (err) => {
      if (err) return api.sendMessage("❌ AYAW PUMAGITNA NG FACEBOOK API, MAANGAS DIN EH!", threadID, messageID);
      return api.sendMessage(`👑 AKO ANG NASUSUNOD DITO! NAKA-LOCK NA GC NAME NG THREAD NA 'TO SA: "${newGName}" 💯 🤪`, threadID, messageID);
    });
    return;
  }

  // /ryukpogi setnick <name>
  if (sub === "setnick") {
    const newNick = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    threadData.lockedNick = newNick;
    allData[threadID] = threadData;
    saveAllData(allData);

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs || [];

      api.sendMessage(`⏳ ISSUING AUTHORITATIVE COMMAND: LOCKING ALL NICKNAMES IN THIS GC TO "${newNick}" (2s SAFE SPEED)... 💀⚡`, threadID);

      for (const uid of participantIDs) {
        await sleep(2000);
        api.changeNickname(newNick, threadID, uid, () => {});
      }
      return api.sendMessage(`👑 LAHAT NG TAO SA GC NA 'TO MAY PARUSA AT NAKA-NICKNAME NA KAY "${newNick}"! WALANG MAKAKALIGTAS! 💯 🤪`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ NAGKA-ERROR SA PAGSET NG NICKNAME, MAY LUMALAGANAP NA REBELDE!", threadID, messageID);
    }
  }

  // /ryukpogi status
  if (sub === "status") {
    if (!threadData.active) {
      return api.sendMessage("⚠️ RYUK POGI IS OFF IN THIS GC. TULOG ANG HARING MAG-AASAR!", threadID, messageID);
    }
    return api.sendMessage(
      `⚡ RYUK POGI GC STATUS REPORT ⚡\n\n` +
      `🔥 STATE: ACTIVE IN THIS GC (24/7)\n` +
      `⏱️ DURATION: LIFETIME / INFINITE\n` +
      `📌 GC NAME GUARD: "${threadData.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `📌 NICKNAME GUARD: "${threadData.lockedNick || DEFAULT_LOCKED_NAME}"\n\n` +
      `WALANG LUGAR ANG MAHIHINA AT EPAL DITO SA GC NA 'TO! 🤪 💯`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `🔥 RYUK POGI CONTROL PANEL (THIS GC ONLY) 🔥\n\n` +
    `👉 /ryukpogi on — Sindi ang maangas na auto-roast sa GC na 'to\n` +
    `👉 /ryukpogi off — Patayin ang auto-roast mode sa GC na 'to\n` +
    `👉 /ryukpogi setgname <name> — I-lock ang pangalan ng GC na 'to\n` +
    `👉 /ryukpogi setnick <name> — I-lock ang nicknames ng members sa GC na 'to (2s delay)\n` +
    `👉 /ryukpogi status — Tignan ang status ng bot sa GC na 'to`,
    threadID,
    messageID
  );
};
