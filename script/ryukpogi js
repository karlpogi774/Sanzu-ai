  name: "ryukpogi",
  version: "8.0.0",
  hasPermission: 1,
  credits: "sinzu & Gemini",
  description: "Anti-restriction short lines auto reply with instant command reaction.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/ryukpogi on | off | status | setgname <name> | setnick <name>",
  cooldowns: 3
};

