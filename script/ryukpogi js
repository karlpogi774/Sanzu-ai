  name: "ryukpogi",
  version: "11.0.0",
  hasPermission: 1,
  credits: "sinzu & Gemini",
  description: "Lamya auto reply with 1s setgname delay and crash-proof anti-detection protection.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/ryukpogi on | off | status | setgname <name> | setnick <name>",
  cooldowns: 3
};

