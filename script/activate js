const fs = require("fs");
const path = require("path");

// ==========================================
// CONFIGURATION
// Replace "100000000000000" with YOUR actual Facebook User ID (UID)
const ADMIN_ID = "100000000000000"; 
// ==========================================

module.exports.config = {
  name: "jehoshbot",
  version: "1.0.0",
  hasPermission: 2, // Admin-only command execution
  credits: "jehosh",
  description: "Jehosh suite: Anti-spam, auto react, self-react, auto rename all members to 'jehosh', and lock GC name to 'jehosh'.",
  usePrefix: true,
  commandCategory: "Admin",
  usages: "/jehoshbot on — activate features\n/jehoshbot off — deactivate features\n/jehoshbot status — check status",
  cooldowns: 5
};

const DATA_PATH = path.join(__dirname, "jehoshbot_data.json");

// Anti-Spam settings
const COOLDOWN_MS = 2500; // 2.5s delay per GC trigger
const USER_SPAM_LIMIT = 3; // Max 3 messages in 10s window per user
const SPAM_WINDOW_MS = 10000;

const lastReplyTime = {};
const userMessageTracker = {};

const TARGET_NAME = "jehosh";
const EMOJIS = ["🔥", "💀", "👑", "⚡", "😎", "🤡", "🚮"];

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      return JSON.parse(fs.readFileSync(DATA_PATH, "utf8"));
    }
  } catch {}
  return { active: false, activatedBy: null };
}

function saveData(data) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2));
}

function isSpamming(senderID) {
  const now = Date.now();
  if (!userMessageTracker[senderID]) {
    userMessageTracker[senderID] = [];
  }
  userMessageTracker[senderID] = userMessageTracker[senderID].filter(t => now - t < SPAM_WINDOW_MS);
  userMessageTracker[senderID].push(now);

  return userMessageTracker[senderID].length > USER_SPAM_LIMIT;
}

// Safely rename all members with a staggered delay to avoid Facebook rate limits
function renameAllMembers(api, threadID, nickname) {
  api.getThreadInfo(threadID, (err, info) => {
    if (err || !info || !info.participantIDs) return;
    
    info.participantIDs.forEach((userID, index) => {
      setTimeout(() => {
        api.changeNickname(nickname, threadID, userID, () => {});
      }, index * 1500); // 1.5-second stagger per user
    });
  });
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, messageID, logMessageType, logMessageData, type } = event;
  const botID = api.getCurrentUserID();
  const data = loadData();

  if (!data.active) return;

  // 1. AUTO GC NAME LOCK (Reverts GC name back to "jehosh" if changed)
  if (logMessageType === "log:thread-name") {
    if (logMessageData.name !== TARGET_NAME) {
      api.setTitle(TARGET_NAME, threadID, (err) => {
        if (!err) api.sendMessage(`🔒 GC Name is locked to "${TARGET_NAME}".`, threadID);
      });
      return;
    }
  }

  // Ignore bot's own actions
  if (senderID === botID) return;

  // 2. ANTI-SPAM GUARD
  if (isSpamming(senderID)) return;

  const now = Date.now();
  if (lastReplyTime[threadID] && (now - lastReplyTime[threadID] < COOLDOWN_MS)) {
    return;
  }

  // 3. AUTO REACT TO INCOMING MESSAGES
  if (type === "message" || type === "message_reply") {
    lastReplyTime[threadID] = now;
    const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];

    // React to user message
    api.setMessageReaction(randomEmoji, messageID, () => {}, true);

    // 4. BOT SELF-REACT (Sends notification confirmation and self-reacts)
    const botResponse = `⚡ [Jehosh Security Active]`;
    api.sendMessage(botResponse, threadID, (err, info) => {
      if (!err && info && info.messageID) {
        const selfEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
        api.setMessageReaction(selfEmoji, info.messageID, () => {}, true);
      }
    });
  }
};

// ===== COMMAND RUNNER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;
  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  // STRICT ADMIN GUARD: Block non-admin execution
  if (senderID !== ADMIN_ID) {
    return api.sendMessage(
      "🛑 ADMIN ONLY! You are not authorized to control this bot.",
      threadID,
      messageID
    );
  }

  if (sub === "on") {
    data.active = true;
    data.activatedBy = senderID;
    saveData(data);

    // Change group name to "jehosh"
    api.setTitle(TARGET_NAME, threadID, (err) => {
      if (err) api.sendMessage("Failed to set GC name. Make sure bot is group admin!", threadID, messageID);
    });

    // Rename all members to "jehosh"
    renameAllMembers(api, threadID, TARGET_NAME);

    return api.sendMessage(
      `🔥 JEHOSH BOT: ACTIVATED\n\n` +
      `• Group Name set & locked to: "${TARGET_NAME}"\n` +
      `• Renaming all members to: "${TARGET_NAME}"\n` +
      `• Auto-React & Auto Self-React Enabled\n` +
      `• Anti-Spam Filter Active`,
      threadID,
      messageID
    );
  }

  if (sub === "off") {
    data.active = false;
    saveData(data);
    return api.sendMessage("✅ JEHOSH BOT deactivated.", threadID, messageID);
  }

  if (sub === "status") {
    return api.sendMessage(
      `📊 Jehosh Bot Status: ${data.active ? "ACTIVE 🟢" : "INACTIVE 🔴"}\n` +
      `Target GC Name / Nickname: "${TARGET_NAME}"`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Usage (Admin Only):\n` +
    `/jehoshbot on — activate features\n` +
    `/jehoshbot off — deactivate features\n` +
    `/jehoshbot status — check status`,
    threadID,
    messageID
  );
};
