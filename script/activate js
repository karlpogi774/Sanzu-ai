const login = require("fca-unofficial"); // O ang gamit mong fca package

// Configuration
const TARGET_NAME = "Jehosh Pogi";
const MIN_DELAY = 3500; // 3.5 seconds (Iwas Restriction)
const MAX_DELAY = 5000; // 5.0 seconds

// Random delay function para mukhang totoong tao ang nag-a-act
function getRandomDelay() {
  return Math.floor(Math.random() * (MAX_DELAY - MIN_DELAY + 1)) + MIN_DELAY;
}

login({ appState: JSON.parse(fs.readFileSync('appstate.json', 'utf8')) }, (err, api) => {
  if (err) return console.error(err);

  // Set safety options
  api.setOptions({
    listenEvents: true,
    selfListen: false,
    autoMarkDelivery: false
  });

  console.log("Autobot active. Anti-restriction delays applied.");

  api.listenMqtt(async (err, event) => {
    if (err) return console.error(err);

    const threadID = event.threadID;

    // 1. AUTO CHANGE NICKNAMES FOR ALL MEMBERS (At Revert kapag pinalitan nila)
    if (event.type === "message" || event.type === "event") {
      api.getThreadInfo(threadID, (err, info) => {
        if (err || !info) return;

        // I-set ang GC Name kung hindi "Jehosh Pogi"
        if (info.threadName !== TARGET_NAME) {
          setTimeout(() => {
            api.setTitle(TARGET_NAME, threadID, (err) => {
              if (!err) console.log(`[GC Name Protection] Changed group name to: ${TARGET_NAME}`);
            });
          }, getRandomDelay());
        }

        // I-set ang Nickname ng bawat member kung hindi "Jehosh Pogi"
        const currentNicknames = info.nicknames || {};
        info.participantIDs.forEach((userID) => {
          if (currentNicknames[userID] !== TARGET_NAME) {
            setTimeout(() => {
              api.changeNickname(TARGET_NAME, threadID, userID, (err) => {
                if (!err) console.log(`[Nickname Protection] Set ${userID} to ${TARGET_NAME}`);
              });
            }, getRandomDelay());
          }
        });
      });
    }

    // 2. SLOW-MOTION AUTO-REPLY (Pang-asar feature)
    if (event.type === "message" && event.body) {
      const responses = [
        "Luh, umiiyak ka na ba?",
        "Asar na asar ka naman, relaxation muna bro 😂",
        "Jehosh Pogi nga kasi, bakit ayaw mo tanggapin?",
        "Ulit-ulitin mo man, Jehosh Pogi pa rin nagpapatakbo rito!",
        "Chill ka lang, hinay-hinay lang sa pag-reply 😉"
      ];

      const randomResponse = responses[Math.floor(Math.random() * responses.length)];

      // Slow motion delay para sa reply
      setTimeout(() => {
        api.sendMessage(randomResponse, threadID, event.messageID);
      }, getRandomDelay());
    }
  });
});
