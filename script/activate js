const fs = require("fs");
const path = require("path");

module.exports.config = {
  name: "activate",
  version: "12.0.0",
  hasPermission: 0,
  credits: "sinzu",
  description: "Thread-focused auto-roast with working dog reaction (🐶), self-react, and enforced GC Name & Nicknames ('Ryuk pogi').",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on | off | status | add <text> | listlines | setnick | setgname",
  cooldowns: 5
};

// ADMIN UID LOCK
const ADMIN_UID = "61594022290817";
const TARGET_NAME = "Ryuk pogi";

// EMOJI PARA SA PANG-ASAR SA CHAT NILA (ASO)
const DOG_EMOJI = "🐶";

const DATA_PATH = path.join(__dirname, "activate_data.json");

// Emojis for auto self-react sa reply ng bot
const REACT_EMOJIS = ["🔥", "💀", "🤣", "😆", "🤡", "👎", "💩", "👻"];

// Default Tagalog roasts
const DEFAULT_TAGALOG_ROASTS = [
  "Luh, nag-type pa talaga siya oh, akala mo naman may kumpirmasyon. 💀",
  "Lods, paki-delete na lang 'to bago pa makita ng iba, nakakahiya. 🤣",
  "Lakas ng loob mo mag-chat, pero yung sinabi mo walang kwenta.",
  "Sino nagtanong sa'yo? Lakas maka-main character ah.",
  "Bro, isip muna bago pindot ng send button, napapahalata ka eh.",
  "Pang-asar ba 'yan o self-humiliation? Clarify natin.",
  "Sana bago ka nag-text, nag-isip ka muna ng limang beses.",
  "Quiet ka na lang muna lods, nauubusan na kami ng patience sa'yo.",
  "I-off mo na wifi mo, hindi para sa'yo ang araw na 'to.",
  "Ganda ng sinabi mo ah, kasing ganda ng blankong papel. 🤡",
  "Ulitin mo nga 'yan, para mas lalo ka naming pagtawanan.",
  "May group chat restraint order ka na ba? Kasi lapit na kita i-report.",
  "Tigilan mo na 'yan, pati 'yung keyboard mo sumusuko na sa'yo.",
  "Confidence level: 100%. Sense level: 0%.",
  "Sige lang, ipagpatuloy mo 'yan... hanggang sa wala nang makipag-usap sa'yo."
];

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const parsed = JSON.parse(fs.readFileSync(DATA_PATH, "utf8"));
      if (!parsed.activeThreads) parsed.activeThreads = {};
      if (!parsed.roasts || parsed.roasts.length === 0) {
        parsed.roasts = DEFAULT_TAGALOG_ROASTS;
      }
      return parsed;
    }
  } catch {}
  return { activeThreads: {}, roasts: DEFAULT_TAGALOG_ROASTS };
}

function saveData(data) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2));
}

function isThreadActive(threadID) {
  const data = loadData();
  return !!(data.activeThreads && data.activeThreads[threadID]);
}

const lastResponseTime = new Map();
const COOLDOWN_DELAY = 2000; // 2 Seconds Slow Motion Duration

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// HELPER FUNCTION PARA SA REACTION LOGIC (WITH RETRY & SAFE CALL)
function safeReact(api, emoji, msgID) {
  if (!msgID) return;
  try {
    api.setMessageReaction(emoji, msgID, (err) => {
      if (err) console.error(`[Reaction Failed] Emoji: ${emoji} | Error:`, err);
    }, true);
  } catch (e) {
    console.error("[Reaction Catch Error]:", e);
  }
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;

  if (!isThreadActive(threadID)) return;

  // 1. AUTO-REVERT GC NAME
  if (logMessageType === "log:thread-name" || logMessageType === "log:subscribe" || logMessageType === "log:unsubscribe") {
    if (logMessageData && logMessageData.name !== TARGET_NAME) {
      api.setTitle(TARGET_NAME, threadID, () => {});
    }
    return;
  }

  // 2. AUTO-REVERT NICKNAME
  if (logMessageType === "log:user-nickname") {
    const changedParticipantID = logMessageData ? logMessageData.participant_id : null;
    const newNickname = logMessageData ? logMessageData.nickname : "";

    if (changedParticipantID && newNickname !== TARGET_NAME) {
      api.changeNickname(TARGET_NAME, threadID, changedParticipantID, () => {});
    }
    return;
  }

  // Ignore empty messages, bot's own messages, and the /activate command
  if (!body || senderID === api.getCurrentUserID() || body.toLowerCase().startsWith("/activate")) return;

  const now = Date.now();
  const lastTime = lastResponseTime.get(threadID) || 0;

  if (now - lastTime < COOLDOWN_DELAY) {
    return;
  }

  lastResponseTime.set(threadID, now);

  try {
    // STEP 1: REACT ASO (🐶) AGAD SA MISMONG CHAT NG USER
    safeReact(api, DOG_EMOJI, messageID);

    const data = loadData();
    const roastsList = data.roasts && data.roasts.length > 0 ? data.roasts : DEFAULT_TAGALOG_ROASTS;

    const randomRoast = roastsList[Math.floor(Math.random() * roastsList.length)];
    const randomSelfEmoji = REACT_EMOJIS[Math.floor(Math.random() * REACT_EMOJIS.length)];

    // Typing Delay / Slow Motion
    await sleep(1500);

    // STEP 2: SEND AUTO-REPLY
    api.sendMessage({
      body: randomRoast,
      mentions: [{ tag: `@${senderID}`, id: senderID }]
    }, threadID, async (err, info) => {
      if (!err && info && info.messageID) {
        // Safe 1-second delay bago mag-self react para iwas FB spam block
        await sleep(1000);
        // STEP 3: AUTO SELF-REACT SA REPLY NG BOT
        safeReact(api, randomSelfEmoji, info.messageID);
      }
    }, messageID);
  } catch (error) {
    console.error("Auto-reply error:", error);
  }
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;

  if (String(senderID) !== ADMIN_UID) {
    return api.sendMessage("❌ Restricted Command: Si Admin (Ryuk pogi) lang ang pwedeng gumamit nito.", threadID, messageID);
  }

  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  if (sub === "on") {
    if (!data.activeThreads) data.activeThreads = {};
    data.activeThreads[threadID] = true;
    saveData(data);

    api.setTitle(TARGET_NAME, threadID, () => {});

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      for (const userID of threadInfo.participantIDs) {
        await sleep(300);
        api.changeNickname(TARGET_NAME, threadID, userID, () => {});
      }
    } catch (e) {}

    return api.sendMessage(
      `🔥 LOCAL GC AUTO-ROAST: ON\n\n` +
      `Admin Lock: ACTIVE (${ADMIN_UID})\n` +
      `Focus Mode: Dito lang sa GC na ito gagana 🎯\n` +
      `Target Message Reaction: ACTIVE (🐶 ASO)\n` +
      `Bot Self-Reaction: ACTIVE (ALL Emojis)\n` +
      `Auto GC Name Lock: ACTIVE ("${TARGET_NAME}")\n` +
      `Auto Nickname Lock: ACTIVE ("${TARGET_NAME}")\n\n` +
      `Gamitin ang /activate off para i-off dito sa GC na 'to.`,
      threadID,
      messageID
    );
  }

  if (sub === "off") {
    if (data.activeThreads && data.activeThreads[threadID]) {
      delete data.activeThreads[threadID];
      saveData(data);
    }
    return api.sendMessage("✅ Naka-OFF na ang auto-roast sa GC na ito.", threadID, messageID);
  }

  if (sub === "status") {
    const activeHere = isThreadActive(threadID);
    if (!activeHere) {
      return api.sendMessage("Naka-OFF ang auto-roast dito sa GC na ito sa kasalukuyan.", threadID, messageID);
    }
    const totalLines = (data.roasts || DEFAULT_TAGALOG_ROASTS).length;
    return api.sendMessage(
      `🔥 Ang Auto-roast ay ACTIVE dito sa GC na 'to (INFINITE ♾️)\n` +
      `Authorized Admin: ${ADMIN_UID}\n` +
      `Target Chat Reaction: 🐶 (Aso)\n` +
      `GC Name & Nickname Lock: "${TARGET_NAME}"\n` +
      `Kabuuan ng mga linya: ${totalLines}`,
      threadID,
      messageID
    );
  }

  if (sub === "add") {
    const customLine = args.slice(1).join(" ");
    if (!customLine) {
      return api.sendMessage("❌ Paki-lagay 'yung linyang gusto mong idagdag.", threadID, messageID);
    }

    if (!data.roasts) data.roasts = DEFAULT_TAGALOG_ROASTS;
    data.roasts.push(customLine);
    saveData(data);

    return api.sendMessage(`✅ Tagumpay na naidagdag ang bagong linya:\n"${customLine}"`, threadID, messageID);
  }

  if (sub === "listlines") {
    const list = data.roasts || DEFAULT_TAGALOG_ROASTS;
    let msg = `📜 Lahat ng Tagalog Reply Lines (${list.length}):\n\n`;
    list.forEach((line, index) => {
      msg += `${index + 1}. ${line}\n`;
    });
    return api.sendMessage(msg, threadID, messageID);
  }

  if (sub === "setnick") {
    try {
      const threadInfo = await api.getThreadInfo(threadID);
      for (const userID of threadInfo.participantIDs) {
        await sleep(400);
        api.changeNickname(TARGET_NAME, threadID, userID, () => {});
      }
      return api.sendMessage(`✅ Tagumpay na nabago at na-lock ang lahat ng nicknames papuntang '${TARGET_NAME}'.`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ Bigo sa pagbago ng nicknames. Siguraduhing admin ang bot.", threadID, messageID);
    }
  }

  if (sub === "setgname") {
    api.setTitle(TARGET_NAME, threadID, (err) => {
      if (err) return api.sendMessage("❌ Bigo sa pagbago ng pangalan ng group chat.", threadID, messageID);
      return api.sendMessage(`✅ Ang pangalan ng GC ay na-set at na-lock sa '${TARGET_NAME}'.`, threadID, messageID);
    });
    return;
  }

  return api.sendMessage(
    `Mga Paggamit (Admin Only):\n` +
    `/activate on — Simulan ang auto-roast sa GC na ito\n` +
    `/activate off — Itigil sa GC na ito\n` +
    `/activate status — Tignan ang status\n` +
    `/activate add <text> — Magdagdag ng bagong Tagalog line\n` +
    `/activate listlines — Ilista ang mga linyang pang-asar\n` +
    `/activate setnick — Force update nicknames\n` +
    `/activate setgname — Force update GC name`,
    threadID,
    messageID
  );
};
