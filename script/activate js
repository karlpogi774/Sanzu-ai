const fs = require("fs");
const path = require("path");

module.exports.config = {
  name: "activate",
  version: "1.6.0",
  hasPermission: 0,
  credits: "sinzu",
  description: "24h global auto-roast with anti-spam, auto react, auto self-react, auto rename, & group lock.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on — start all global features\n/activate off — stop\n/activate status — check status",
  cooldowns: 5
};

const DATA_PATH = path.join(__dirname, "activate_data.json");

// Anti-Spam configurations
const COOLDOWN_MS = 3000; // Minimum 3 seconds delay between bot replies in the same thread
const USER_SPAM_LIMIT = 3; // Max messages allowed from a single user in 10 seconds before being muted
const SPAM_WINDOW_MS = 10000;

// Memory storage for anti-spam tracking
const lastReplyTime = {};
const userMessageTracker = {};

// Tagalog/English banter roasts
const ROASTS = [
  "Bro really thought that message was necessary 💀",
  "The confidence… the delusion… unmatched.",
  "Say less, we already lost brain cells reading that.",
  "You typed all that just to embarrass yourself?",
  "Main character energy but the plot is mid.",
  "Who hurt you? Because that sentence hurt all of us.",
  "Please stop before the group chat files a restraining order.",
  "You really just said that out loud… in text… permanently.",
  "The audacity is loud but the intelligence is on mute.",
  "This is why group chats need a mute button for specific people.",
  "Bro woke up and chose violence against the English language.",
  "I’m not even mad, I’m just disappointed… and second-hand embarrassed.",
  "Your message just aged like milk left in the sun.",
  "Somewhere a grammar teacher is crying.",
  "This energy is giving ‘I peaked in high school’.",
  "You dropped that like it was fire. It was not.",
  "The group chat was peaceful until you arrived.",
  "Please log off for the sake of everyone’s mental health.",
  "That was a choice… a bold, terrible choice.",
  "I’m taking notes on how not to communicate."
];

// Emojis for auto-react and auto self-react
const EMOJIS = ["💀", "🤡", "🚮", "😴", "🤣", "💩", "🧠❌", "🤦‍♂️"];

// Random target nicknames for users who speak while active
const NICKNAMES = [
  "Main Character (Delusional)",
  "Chat Spammer 3000",
  "Certified Yapper",
  "NPC #404",
  "Silent Mode Please",
  "Professional Clown"
];

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      return JSON.parse(fs.readFileSync(DATA_PATH, "utf8"));
    }
  } catch {}
  return { expires: 0, activatedBy: null, lockedTitle: null };
}

function saveData(data) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2));
}

function isActive() {
  const data = loadData();
  return data.expires && data.expires > Date.now();
}

function getRemaining() {
  const data = loadData();
  if (!data.expires) return 0;
  const left = data.expires - Date.now();
  return left > 0 ? left : 0;
}

// Anti-Spam validator
function isSpamming(senderID) {
  const now = Date.now();
  if (!userMessageTracker[senderID]) {
    userMessageTracker[senderID] = [];
  }
  // Remove timestamps outside the window
  userMessageTracker[senderID] = userMessageTracker[senderID].filter(t => now - t < SPAM_WINDOW_MS);
  userMessageTracker[senderID].push(now);

  return userMessageTracker[senderID].length > USER_SPAM_LIMIT;
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData, type } = event;
  const botID = api.getCurrentUserID();
  const data = loadData();

  // 1. GROUP LOCK: Revert group title changes if locked
  if (logMessageType === "log:thread-name" && isActive() && data.lockedTitle) {
    if (logMessageData.name !== data.lockedTitle) {
      api.setTitle(data.lockedTitle, threadID, (err) => {
        if (!err) api.sendMessage("🔒 Group name is locked while /activate is active!", threadID);
      });
      return;
    }
  }

  // Basic filters
  if (!isActive() || senderID === botID) return;

  // 2. ANTI-SPAM SAFETY CHECKS
  if (isSpamming(senderID)) return; // Ignore users spamming messages quickly

  const now = Date.now();
  if (lastReplyTime[threadID] && (now - lastReplyTime[threadID] < COOLDOWN_MS)) {
    return; // Enforce minimum delay between bot replies in the same chat
  }

  // 3. AUTO-REACT TO USER'S MESSAGE
  if (type === "message" || type === "message_reply") {
    const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
    api.setMessageReaction(randomEmoji, messageID, () => {}, true);
  }

  // Ignore commands for message roasting & renaming
  if (!body || body.startsWith("/")) return;

  // Update last active time for thread cooldown
  lastReplyTime[threadID] = now;

  // 4. AUTO NICKNAME CHANGE (Occasional to prevent API limit)
  if (Math.random() < 0.5) { // 50% chance per valid message to save API calls
    const randomNick = NICKNAMES[Math.floor(Math.random() * NICKNAMES.length)];
    api.changeNickname(randomNick, threadID, senderID, () => {});
  }

  // 5. AUTO-ROAST WITH AUTO SELF-REACT
  const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
  
  api.sendMessage(randomRoast, threadID, (err, info) => {
    if (!err && info && info.messageID) {
      // Auto Self-React: Reacts to the bot's own newly sent roast message
      const selfEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
      api.setMessageReaction(selfEmoji, info.messageID, () => {}, true);
    }
  }, messageID);
};

// ===== COMMAND =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;
  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  if (sub === "on") {
    const expires = Date.now() + 24 * 60 * 60 * 1000; // 24 hours
    data.expires = expires;
    data.activatedBy = senderID;
    data.activatedAt = Date.now();

    // Lock group title (if in a group chat)
    api.getThreadInfo(threadID, (err, info) => {
      if (!err && info.threadName) {
        data.lockedTitle = info.threadName;
      }
      saveData(data);
    });

    return api.sendMessage(
      `🔥 GLOBAL AUTO-ROAST & BOT SUITE: ON\n\n` +
      `✨ Active Features:\n` +
      `• 1 Message = 1 Roast Reply\n` +
      `• Auto-React (User Messages)\n` +
      `• Auto Self-React (Bot Replies)\n` +
      `• Auto-Change Speaker Nickname\n` +
      `• Group Name Lock\n` +
      `• 🛡️ Anti-Spam Protection (3s Cooldown)\n\n` +
      `Duration: 24 Hours\n` +
      `Use /activate off to stop early.`,
      threadID,
      messageID
    );
  }

  if (sub === "off") {
    if (isActive()) {
      data.expires = 0;
      data.lockedTitle = null;
      saveData(data);
      return api.sendMessage("✅ Global features & Auto-roast turned OFF.", threadID, messageID);
    }
    return api.sendMessage("Auto-roast is not currently active.", threadID, messageID);
  }

  if (sub === "status") {
    const left = getRemaining();
    if (left <= 0) {
      return api.sendMessage("Global features are currently OFF.", threadID, messageID);
    }
    const hours = Math.floor(left / (1000 * 60 * 60));
    const mins = Math.floor((left % (1000 * 60 * 60)) / (1000 * 60));
    return api.sendMessage(
      `🔥 Global Bot Suite is ACTIVE\nTime left: ${hours}h ${mins}m\nFeatures: Roast, Auto-React, Auto Self-React, Anti-Spam`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Usage:\n` +
    `/activate on — start 24h features with auto self-react\n` +
    `/activate off — stop all features\n` +
    `/activate status — check remaining time`,
    threadID,
    messageID
  );
};
