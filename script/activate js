const fs = require("fs");
const path = require("path");

module.exports.config = {
  name: "activate",
  version: "2.2.0",
  hasPermission: 1, // Require Admin Permission Level
  credits: "sinzu & Gemini",
  description: "24-hour global auto-roast with Admin Locks, Render fix, 2s setnick delay, Auto React, and Name Guard.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on | off | status | setgname <name> | setnick <name>",
  cooldowns: 2
};

// ================= CONFIGURATION =================
const ADMIN_UID = "61593892603402";
const DEFAULT_LOCKED_NAME = "Ryuk pogi";
const DATA_PATH = path.join(__dirname, "activate_data.json");

// Emojis for auto-reactions
const EMOJIS = ["🔥", "💀", "🤣", "😆", "🤡", "👎", "💩", "👻", "🐶", "💯"];

