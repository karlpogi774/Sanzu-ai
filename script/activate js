const path = require("path");

module.exports.config = {
  name: "activate",
  version: "3.0.0",
  hasPermission: 1, // Require Admin Permission Level
  credits: "Ryuk & Gemini",
  description: "Infinite per-GC auto-roast with Dog reaction (🐕), Strict GC Isolation, Render Fix, 2s setnick delay, and Name Guard.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on | off | status | setgname <name> | setnick <name>",
  cooldowns: 2
};

// ================= CONFIGURATION =================
// LISTAHAN NG MGA ADMIN UIDs (DALAWANG ACCOUNT MO)
const ADMIN_UIDS = [
  "61593892603402",
  "61594022290817"
];

const DEFAULT_LOCKED_NAME = "Ryuk pogi";
const DATA_PATH = path.join(__dirname, "activate_data.json");

// Single Reaction Emoji (Dog)
const DOG_EMOJI = "🐕";

