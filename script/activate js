const axios = require("axios");
const fs = require("fs-extra");
const path = require("path");

module.exports.config = {
  name: "ryuk",
  version: "21.0.0",
  hasPermission: 0,
  credits: "Ryuk Pogi & Gemini",
  description: "Strict Auto-Lock GC Name/Nicknames, Targeted Roast, Dog React, Self React, & Song Player.",
  usePrefix: true,
  commandCategory: "Media & Fun",
  usages: "/ryuk song <title> | /ryuk on | off | target <@mention/reply/clear> | setnick <name> | setgname <name>",
  cooldowns: 3
};

// ================= CONFIGURATION =================
const ADMIN_UID = "61594022290817";
const DEFAULT_TARGET_NAME = "Ryuk pogi";
const DOG_EMOJI = "🐶";

// PALITAN MULA SA JSONBIN.IO
const JSONBIN_API_KEY = "LAGAY_MO_DITO_ANG_MASTER_KEY";
const JSONBIN_BIN_ID = "LAGAY_MO_DITO_ANG_BIN_ID";

const REACT_EMOJIS = ["🔥", "💀", "🤣", "😆", "🤡", "👎", "💩", "👻"];

const DEFAULT_TAGALOG_ROASTS = [
  "Luh, nag-type pa talaga siya oh, akala mo naman may kumpirmasyon. 💀",
  "Lods, paki-delete na lang 'to bago pa makita ng iba, nakakahiya. 🤣",
  "Lakas ng loob mo mag-chat, pero yung sinabi mo walang kwenta.",
  "Sino nagtanong sa'yo? Lakas maka-main character ah.",
  "Bro, isip muna bago pindot ng send button, napapahalata ka eh.",
  "Pang-asar ba 'yan o self-humiliation? Clarify natin.",
  "Sana bago ka nag-text, nag-isip ka muna ng limang beses.",
  "Quiet ka na lang muna lods, nauubusan na kami ng patience sa'yo.",
  "I-off mo na wifi mo, hindi para sa'yo ang araw na 'to.",
  "Ganda ng sinabi mo ah, kasing ganda ng blankong papel. 🤡",
  "Ulitin mo nga 'yan, para mas lalo ka naming pagtawanan.",
  "May group chat restraint order ka na ba? Kasi lapit na kita i-report.",
  "Tigilan mo na 'yan, pati 'yung keyboard mo sumusuko na sa'yo.",
  "Confidence level: 100%. Sense level: 0%.",
  "Sige lang, ipagpatuloy mo 'yan... hanggang sa wala nang makipag-usap sa'yo.",
  "Ayan ka na naman, nagkakalat ka na naman ng ingay sa GC.",
  "Subukan mo kayang mag-isip bago mag-type? Baka makatulong.",
  "Ang ingay mo, wala ka namang maipagmamabang.",
  "Kung degree ang pagiging corny, summa cum laude ka na siguro.",
  "Bakit ka nag-chat? May humingi ba ng opinyon mo?",
  "Hindi ka nakakatuwa, nakakaawa ka na pakinggan.",
  "Yung utak mo parang Internet Explorer, huling-huli sa balita.",
  "Lakas magmarunong pero nung nagtanong, nganga naman.",
  "Tulog mo na lang 'yan lods, wala ka talagang mapapala ngayon.",
  "Walang nakikinig sa'yo, kaya wag ka nang mag-aksaya ng laway.",
  "Gusto mo ba ng medalya dahil sa walang katuturan mong sinabi?",
  "Tae ka ba? Kasi nakaka-bwisit ka sa paningin.",
  "Puro ka dada, zero performance ka naman sa totoong buhay.",
  "Sana binasa mo muna bago mo pinindot 'yung send.",
  "Dami mong sinasabi, wala namang katuturan."
];

let memoryData = { activeThreads: {}, targets: {}, gcNames: {}, nicknames: {}, roasts: DEFAULT_TAGALOG_ROASTS };

async function loadData() {
  try {
    const res = await axios.get(`https://api.jsonbin.io/v3/b/${JSONBIN_BIN_ID}/latest`, {
      headers: { "X-Master-Key": JSONBIN_API_KEY }
    });
    if (res.data && res.data.record) {
      memoryData = res.data.record;
      if (!memoryData.activeThreads) memoryData.activeThreads = {};
      if (!memoryData.targets) memoryData.targets = {};
      if (!memoryData.gcNames) memoryData.gcNames = {};
      if (!memoryData.nicknames) memoryData.nicknames = {};
      if (!memoryData.roasts || memoryData.roasts.length === 0) memoryData.roasts = DEFAULT_TAGALOG_ROASTS;
    }
  } catch (err) {
    console.error("[JSONBin Load Error]:", err.message);
  }
  return memoryData;
}

async function saveData(data) {
  memoryData = data;
  try {
    await axios.put(`https://api.jsonbin.io/v3/b/${JSONBIN_BIN_ID}`, data, {
      headers: {
        "Content-Type": "application/json",
        "X-Master-Key": JSONBIN_API_KEY
      }
    });
  } catch (err) {
    console.error("[JSONBin Save Error]:", err.message);
  }
}

function isThreadActive(threadID) {
  return !!(memoryData.activeThreads && memoryData.activeThreads[threadID]);
}

const lastResponseTime = new Map();
const COOLDOWN_DELAY = 2500;
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

loadData();

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;

  if (!isThreadActive(threadID)) return;

  const currentLockedGcName = memoryData.gcNames[threadID] || DEFAULT_TARGET_NAME;
  const currentLockedNickname = memoryData.nicknames[threadID] || DEFAULT_TARGET_NAME;
  const targetUser = memoryData.targets[threadID] || null;

  // 1. STRICT AUTO-REVERT GC NAME
  if (logMessageType === "log:thread-name") {
    const newGcName = logMessageData ? logMessageData.name : "";
    if (newGcName !== currentLockedGcName) {
      api.setTitle(currentLockedGcName, threadID, (err) => {
        if (!err) {
          api.sendMessage(`🚫 Bawal palitan ang GC Name! Naka-lock ito sa: "${currentLockedGcName}"`, threadID);
        }
      });
    }
    return;
  }

  // 2. STRICT AUTO-REVERT NICKNAME
  if (logMessageType === "log:user-nickname") {
    const changedParticipantID = logMessageData ? logMessageData.participant_id : null;
    const newNickname = logMessageData ? logMessageData.nickname : "";

    if (changedParticipantID && newNickname !== currentLockedNickname) {
      await sleep(800);
      api.changeNickname(currentLockedNickname, threadID, changedParticipantID, () => {});
    }
    return;
  }

  if (!body || senderID === api.getCurrentUserID() || body.toLowerCase().startsWith("/ryuk")) return;

  // AUTO DOG REACT (🐶) SA CHAT NG MGA USER
  api.setMessageReaction(DOG_EMOJI, messageID, () => {}, true);

  // KUNG MAY SPECIFIC TARGET: DITO LANG MAG-ROAST KAPAG YUNG TARGET ANG NAG-CHAT
  if (targetUser && String(senderID) !== String(targetUser)) return;

  const now = Date.now();
  const lastTime = lastResponseTime.get(threadID) || 0;
  if (now - lastTime < COOLDOWN_DELAY) return;
  lastResponseTime.set(threadID, now);

  try {
    const roastsList = memoryData.roasts && memoryData.roasts.length > 0 ? memoryData.roasts : DEFAULT_TAGALOG_ROASTS;
    const randomRoast = roastsList[Math.floor(Math.random() * roastsList.length)];
    const randomSelfEmoji = REACT_EMOJIS[Math.floor(Math.random() * REACT_EMOJIS.length)];

    await sleep(800);

    // AUTO REPLY + GUARANTEED SELF-REACT
    api.sendMessage({
      body: randomRoast,
      mentions: [{ tag: `@${senderID}`, id: senderID }]
    }, threadID, (err, info) => {
      if (!err && info && info.messageID) {
        setTimeout(() => {
          api.setMessageReaction(randomSelfEmoji, info.messageID, () => {}, true);
        }, 800);
      }
    }, messageID);
  } catch (error) {
    console.error("Auto-reply error:", error);
  }
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID, mentions, messageReply } = event;

  await loadData();
  const sub = (args[0] || "").toLowerCase();

  // ================= SONG REQUEST PLAYER =================
  if (sub === "song" || sub === "sing" || sub === "music") {
    const songName = args.slice(1).join(" ");
    if (!songName) return api.sendMessage("🎶 Paki-lagay ang pamagat ng kanta.\nHalimbawa: /ryuk song Pasilyo", threadID, messageID);

    api.sendMessage(`🔍 Hinahanap ang kantang "${songName}"... Paki-hintay nang kaunti. 🎵`, threadID, messageID);

    const cachePath = path.resolve(__dirname, 'cache', `${Date.now()}_song.mp3`);

    try {
      // Free YouTube/Music Search API
      const searchRes = await axios.get(`https://api.popcat.click/song?q=${encodeURIComponent(songName)}`);
      
      if (!searchRes.data || !searchRes.data.url) {
        return api.sendMessage("❌ Bigo sa paghahanap ng kanta. Subukan ang ibang title.", threadID, messageID);
      }

      const songData = searchRes.data;
      const downloadStream = await axios({
        method: 'get',
        url: songData.url,
        responseType: 'stream'
      });

      fs.ensureDirSync(path.resolve(__dirname, 'cache'));
      const writer = fs.createWriteStream(cachePath);
      downloadStream.data.pipe(writer);

      writer.on('finish', () => {
        api.sendMessage({
          body: `🎶 **Title:** ${songData.title || songName}\n👤 **Artist:** ${songData.artist || "Unknown"}\n\n▶️ *Enjoy your music from Ryuk System!*`,
          attachment: fs.createReadStream(cachePath)
        }, threadID, () => fs.unlinkSync(cachePath), messageID);
      });

      writer.on('error', () => {
        return api.sendMessage("❌ Nagka-error sa pag-download ng audio file.", threadID, messageID);
      });

    } catch (e) {
      return api.sendMessage("❌ May problema sa music provider. Pakisubukan muli mamaya.", threadID, messageID);
    }
    return;
  }

  // ================= ADMIN CONTROLLED COMMANDS =================
  if (String(senderID) !== ADMIN_UID) {
    return api.sendMessage("❌ Restricted: Si Ryuk Pogi lang ang pwedeng mag-control sa settings ng bot.", threadID, messageID);
  }

  // /ryuk on
  if (sub === "on") {
    if (!memoryData.activeThreads) memoryData.activeThreads = {};
    memoryData.activeThreads[threadID] = true;
    await saveData(memoryData);

    return api.sendMessage(`🔥 RYUK SYSTEM: ACTIVATED sa GC na ito! Auto Dog React (🐶), Strict Locks, at Song Player are ready.`, threadID, messageID);
  }

  // /ryuk off
  if (sub === "off") {
    if (memoryData.activeThreads && memoryData.activeThreads[threadID]) {
      delete memoryData.activeThreads[threadID];
      await saveData(memoryData);
    }
    return api.sendMessage("✅ Naka-OFF na ang Ryuk System sa GC na ito.", threadID, messageID);
  }

  // /ryuk setgname <pangalan>
  if (sub === "setgname") {
    const newGcName = args.slice(1).join(" ");
    if (!newGcName) return api.sendMessage("❌ Paki-lagay ang ilo-lock na GC Name.", threadID, messageID);

    memoryData.gcNames[threadID] = newGcName;
    await saveData(memoryData);

    api.setTitle(newGcName, threadID, (err) => {
      if (err) return api.sendMessage("❌ Bigo sa pagpapalit ng GC Name.", threadID, messageID);
      return api.sendMessage(`🔒 GC Name is now STRICTLY LOCKED to: "${newGcName}"`, threadID, messageID);
    });
    return;
  }

  // /ryuk target <Mention / Reply / UID / clear>
  if (sub === "target") {
    let targetID = null;

    if (Object.keys(mentions).length > 0) {
      targetID = Object.keys(mentions)[0];
    } else if (messageReply && messageReply.senderID) {
      targetID = messageReply.senderID;
    } else if (args[1] && !isNaN(args[1])) {
      targetID = args[1];
    } else if (args[1] && args[1].toLowerCase() === "clear") {
      delete memoryData.targets[threadID];
      await saveData(memoryData);
      return api.sendMessage("🎯 Target Cleared! Gagana na ulit ang auto-roast reply sa LAHAT.", threadID, messageID);
    }

    if (!targetID) {
      return api.sendMessage("❌ Paki-tag ang ie-asar, mag-reply sa message niya, o i-paste ang UID.", threadID, messageID);
    }

    memoryData.targets[threadID] = targetID;
    await saveData(memoryData);

    return api.sendMessage(`🎯 TARGET LOCKED: Nakatutok na ang auto-roast kay UID: ${targetID}`, threadID, messageID);
  }

  // /ryuk setnick <name>
  if (sub === "setnick") {
    const newNickname = args.slice(1).join(" ");
    if (!newNickname) return api.sendMessage("❌ Paki-lagay ang gustong Nickname.", threadID, messageID);

    memoryData.nicknames[threadID] = newNickname;
    await saveData(memoryData);

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs || [];

      api.sendMessage(`⏳ Isina-set at kino-lock ang nickname na "${newNickname}" sa lahat...`, threadID);

      for (const userID of participantIDs) {
        await sleep(800);
        api.changeNickname(newNickname, threadID, userID, () => {});
      }
      return api.sendMessage(`🔒 Successfully locked nicknames to: "${newNickname}"`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ Bigo sa pagbago ng nicknames.", threadID, messageID);
    }
  }

  // /ryuk status
  if (sub === "status") {
    const activeHere = isThreadActive(threadID);
    const target = memoryData.targets[threadID] ? memoryData.targets[threadID] : "LAHAT (No Specific Target)";
    const targetGcName = memoryData.gcNames[threadID] || DEFAULT_TARGET_NAME;
    const targetNickname = memoryData.nicknames[threadID] || DEFAULT_TARGET_NAME;

    return api.sendMessage(
      `🔥 RYUK SYSTEM STATUS:\n` +
      `Active: ${activeHere ? "YES 🟢" : "NO 🔴"}\n` +
      `Locked GC Name: "${targetGcName}"\n` +
      `Locked Nickname: "${targetNickname}"\n` +
      `Current Roast Target: ${target}\n` +
      `Song Player: ACTIVE 🎵`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Mga Command ni Ryuk:\n` +
    `🎵 /ryuk song <title> — Mag-patugtog ng kanta (Kahit sino pwedeng gumamit)\n` +
    `/ryuk on — Simulan ang script sa GC\n` +
    `/ryuk off — Itigil ang script\n` +
    `/ryuk setgname <name> — Lock GC Name (Anti-Change)\n` +
    `/ryuk target — I-reply ito sa chat ng ta-targetin\n` +
    `/ryuk setnick <name> — Lock Nickname sa lahat\n` +
    `/ryuk status — Status check`,
    threadID,
    messageID
  );
};
