/**
 * Facebook Messenger Group Chat Admin & Protection Bot (Extended Text Edition)
 * Admin ID: 61593892603402
 * Response Delay: 3 Seconds (3000ms)
 */

const login = require('fca-project-origo');
const fs = require('fs');

// Global System Configurations
const ADMIN_ID = "61593892603402";
const RESPONSE_DELAY_MS = 3000; // 3 Seconds Delay

// State Storage for Group Protection (Locks)
let lockedGCName = {}; // Stores locked GC Names per Thread ID
let lockedNickname = {}; // Stores locked Nicknames per Thread ID

// Load Facebook Credentials (AppState)
let appState;
try {
  appState = JSON.parse(fs.readFileSync('appstate.json', 'utf8'));
} catch (err) {
  console.error('[ERROR] Hindi mahanap ang appstate.json file. Paki-ilagay ang iyong Facebook AppState cookies.');
  process.exit(1);
}

login({ appState: appState }, (err, api) => {
  if (err) return console.error('[LOGIN ERROR]', err);

  // Configure Bot Options
  api.setOptions({
    listenEvents: true,
    selfListen: false,
    logLevel: "silent"
  });

  console.log(`======================================================================`);
  console.log(` ANG MGA AUTOMATED MESSAGING MODULES AY HANDA AT AKTIBO NA`);
  console.log(` VERIFIED SINGLE ADMIN IDENTIFIER: ${ADMIN_ID}`);
  console.log(` ENFORCED RESPONSE BUFFER QUEUE DELAY: 3 SECONDS (3000 MS)`);
  console.log(`======================================================================`);

  // Message and Event Listener Loop
  api.listenMqtt(async (err, event) => {
    if (err) return console.error('[MQTT ERROR]', err);

    const threadID = event.threadID;

    // -------------------------------------------------------------------
    // 1. EVENT HANDLER: Auto-Reset GC Name & Auto-Reset Nickname Locks
    // -------------------------------------------------------------------
    if (event.type === "event") {
      
      // Event: May nagpalit ng GC Name
      if (event.logMessageType === "log:thread-name") {
        const newName = event.logMessageData.name;
        const authorID = event.author;

        // Kung naka-lock ang GC Name at hindi ang Admin ang nagpalit
        if (lockedGCName[threadID] && newName !== lockedGCName[threadID] && authorID !== ADMIN_ID) {
          console.log(`[PROTECTION] Pinalitan ang GC Name ni ${authorID}. Ibabalik sa locked state...`);
          
          api.setTitle(lockedGCName[threadID], threadID, (err) => {
            if (!err) {
              api.sendMessage(
                `======================================================================\n` +
                `⚠️ BABALA NG AUTOMATED SECURITY ENGINE: BAWAL PALITAN ANG GC NAME!\n` +
                `======================================================================\n\n` +
                `Isang hindi awtorisadong pagtatangka sa pagpapalit ng pangalan ng ating Group Chat ang naidetekto ng ating system!\n\n` +
                `📌 DETALYE NG PAGBAGAO:\n` +
                `- User ID na Nagtangka: ${authorID}\n` +
                `- Piniling Pangalan: "${newName}"\n\n` +
                `🛑 HINDI PINAYAGAN ANG PAGBABAGO:\n` +
                `Ang pangalan ng pangkat na ito ay nakakandado at pinoprotektahan ng ating bot system. Ang opisyal na pangalan ay pinanatili at awtomatikong ibinalik sa:\n` +
                `👉 "${lockedGCName[threadID]}"\n\n` +
                `PAPAALALA: Ang aming Administrator (${ADMIN_ID}) lamang ang may absolute permission na magbago ng mga setting ng pangkat na ito. Maraming salamat sa inyong pag-unawa at kooperasyon.`,
                threadID
              );
            }
          });
        }
      }

      // Event: May nagpalit ng Nickname
      if (event.logMessageType === "log:user-nickname") {
        const targetID = event.logMessageData.participant_id;
        const authorID = event.author;
        const newNick = event.logMessageData.nickname;

        // Kung naka-lock ang Nickname at hindi Admin ang nagpalit
        if (lockedNickname[threadID] && newNick !== lockedNickname[threadID] && authorID !== ADMIN_ID) {
          console.log(`[PROTECTION] Pinalitan ang Nickname ni ${authorID}. Ibabalik sa locked state...`);

          api.changeNickname(lockedNickname[threadID], threadID, targetID, (err) => {
            if (!err) {
              api.sendMessage(
                `======================================================================\n` +
                `⚠️ AUTOMATED NICKNAME PROTECTION SYSTEM ENFORCEMENT\n` +
                `======================================================================\n\n` +
                `Isang hindi awtorisadong pagpapalit ng pangalan (nickname) ang naitala sa ating security event logs!\n\n` +
                `📌 TAONG NAPALITAN ANG NICKNAME: Account ID (${targetID})\n` +
                `📌 TAONG NAGTANGKANG MAGPALIT: Account ID (${authorID})\n` +
                `📌 HINDI PINAYAGANG NICKNAME: "${newNick}"\n\n` +
                `🛡️ SYSTEM OVERRIDE EXECUTION:\n` +
                `Ipinag-uutos ng ating Administrator (${ADMIN_ID}) na ang lahat ng kasapi sa pangkat na ito ay dapat magkaroon ng nakatakdang uniform nickname. Awtomatikong ibinalik ang nickname sa:\n` +
                `👉 "${lockedNickname[threadID]}"\n\n` +
                `Mangyaring huwag nang subukang palitan muli ang inyong katawagan upang maiwasan ang paulit-ulit na pagpapadala ng babala sa chat na ito.`,
                threadID
              );
            }
          });
        }
      }
      return;
    }

    // -------------------------------------------------------------------
    // 2. MESSAGE HANDLER: Admin Commands & Auto-Reply Engine
    // -------------------------------------------------------------------
    if (event.type === "message" && event.body) {
      const senderID = event.senderID;
      const messageText = event.body.trim();

      // SECURITY LOCK: Ignorahin ang lahat ng mensahe kapag hindi galing sa Admin
      if (senderID !== ADMIN_ID) {
        return; 
      }

      // Typing Indicator Feature (3 Seconds Delay)
      api.sendTypingIndicator(threadID, (err) => {
        setTimeout(() => {
          processAdminCommands(api, threadID, messageText);
        }, RESPONSE_DELAY_MS);
      });
    }
  });
});

// -------------------------------------------------------------------
// 3. ADMIN COMMAND PROCESSOR & EXTENDED TEXT AUTO-REPLY ENGINE
// -------------------------------------------------------------------
function processAdminCommands(api, threadID, input) {
  const args = input.split(' ');
  const command = args[0].toLowerCase();
  const content = args.slice(1).join(' ');

  // Command 1: !setgname [Pangalan]
  if (command === '!setgname' || command === '/setgname') {
    if (!content) {
      return api.sendMessage(
        `======================================================================\n` +
        `📖 GABAY SA PAG-EXECUTE NG COMMAND: !setgname\n` +
        `======================================================================\n\n` +
        `Isang malugod na pagbati sa iyo, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
        `Nais mong palitan at i-lock ang pangalan ng Group Chat na ito ngunit kulang ang mga parameter na iyong ipinadala sa system.\n\n` +
        `📌 TAMANG ESTRUKTURA NG UTOS:\n` +
        `!setgname [Isulat Dito Ang Bagong Pangalan Ng GC]\n\n` +
        `💡 HALIMBAWA NG PAGSASAGAWA:\n` +
        `!setgname Opisyal Na Pangkat Ng Mga Administrador 2026\n\n` +
        `Pagkatapos mong i-type ito, awtomatikong papalitan ng bot ang pangalan at maglalagay ng security lock upang wala nang ibang makapagbago nito kailanman.`,
        threadID
      );
    }

    lockedGCName[threadID] = content;
    api.setTitle(content, threadID, (err) => {
      if (err) return api.sendMessage(`[ERROR] Hindi ma-set ang GC Name: ${err.error}`, threadID);
      
      api.sendMessage(
        `======================================================================\n` +
        `📢 OPISYAL NA ANUNSYO: ANG PANGALAN NG GROUP CHAT AY NAISAYOS AT NAILOCK NA!\n` +
        `======================================================================\n\n` +
        `Pansin sa lahat ng mga miyembro at kasapi ng pangkat na ito! Ang ating opisyal na Administrator (${ADMIN_ID}) ay matagumpay na naglapat ng panibagong katawagan para sa ating Group Chat.\n\n` +
        `🏆 BAGONG OPISYAL NA PANGALAN NG PANGKAT:\n` +
        `👉 "${content}"\n\n` +
        `🛡️ IMPLEMENTASYON NG PROTUKOL NG SEGURIDAD:\n` +
        `1. Ang pangalang ito ay ganap nang NAKAKANDADO sa ating database memory.\n` +
        `2. Anumang pagtatangka ng hindi awtorisadong miyembro na palitan ang pangalan na ito ay awtomatikong haharangan at ibabalik ng system sa eksaktong pangalang ito.\n` +
        `3. Ang mga pagbabago ay maaari lamang isagawa muli sa pamamagitan ng direktang utos mula sa ating nakatalagang Administrator.\n\n` +
        `Maraming salamat sa patuloy na paggalang sa mga alituntunin ng ating pangkat!`,
        threadID
      );
    });
    return;
  }

  // Command 2: !setnick [Nickname]
  if (command === '!setnick' || command === '/setnick') {
    if (!content) {
      return api.sendMessage(
        `======================================================================\n` +
        `📖 GABAY SA PAG-EXECUTE NG COMMAND: !setnick\n` +
        `======================================================================\n\n` +
        `Isang malugod na pagbati sa iyo, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
        `Nais mong palitan at i-lock ang nickname ng LAHAT ng miyembro ngunit nakalimutan mong ilagay ang salitang ilalapat sa kanila.\n\n` +
        `📌 TAMANG ESTRUKTURA NG UTOS:\n` +
        `!setnick [Isulat Dito Ang Nickname Para Sa Lahat]\n\n` +
        `💡 HALIMBAWA NG PAGSASAGAWA:\n` +
        `!setnick Opisyal Na Miyembro\n\n` +
        `Pagkatapos mong i-type ito, awtomatikong iisa-isahin ng bot ang lahat ng miyembro upang palitan ang kanilang mga palayaw at i-lock ang mga ito.`,
        threadID
      );
    }

    lockedNickname[threadID] = content;

    api.getThreadInfo(threadID, (err, info) => {
      if (err) return api.sendMessage(`[ERROR] Hindi makuha ang impormasyon ng pangkat: ${err.error}`, threadID);

      const participantIDs = info.participantIDs;
      participantIDs.forEach((pID) => {
        api.changeNickname(content, threadID, pID);
      });

      api.sendMessage(
        `======================================================================\n` +
        `📢 OPISYAL NA AUTOMATED NICKNAME SYNCHRONIZATION EXECUTION\n` +
        `======================================================================\n\n` +
        `Ipinag-uutos ng ating Kagalang-galang na Administrator (${ADMIN_ID}) na ang LAHAT ng kasalukuyang miyembro sa Group Chat na ito ay papalitang muli ng kanilang mga opisyal na katawagan.\n\n` +
        `🏷️ UNIFORM NICKNAME NA ILINAPAT SA LAHAT:\n` +
        `👉 "${content}"\n\n` +
        `🛡️ AUTOMATED PROTECTION ENGAGEMENT:\n` +
        `- Ang lahat ng account sa chat na ito ay naisaayos na sa pare-parehong nickname.\n` +
        `- Kapag pinalitan ng sinuman ang kanilang nickname pabalik sa dati o sa ibang salita, awtomatiko itong ibabalik ng ating bot script sa nakaset na nickname na ito matapos ang ilang segundo.\n\n` +
        `Inaaasahan ang lahat na panatilihin ang kaayusan sa ating silid-talakayan.`,
        threadID
      );
    });
    return;
  }

  // Command 3: !rules / !alituntunin
  if (command === '!rules' || command === '!alituntunin') {
    return api.sendMessage(
      `======================================================================\n` +
      `📜 OPISYAL NA MGA ALITUNTUNIN AT KAUTUSAN SA GROUP CHAT\n` +
      `======================================================================\n\n` +
      `Upang mapanatili ang kaayusan, katahimikan, at magandang samahan ng bawat isa sa ating pangkat, inilalabas ng ating Administrator (${ADMIN_ID}) ang mga sumusunod na alituntunin:\n\n` +
      `1. BAWAL ANG PAGPAPALIT NG GC NAME AT NICKNAMES\n` +
      `   - Ang pangalan ng GC at ang mga nicknames ay nakakandado sa ating bot system. Huwag nang subukang palitan ang mga ito.\n\n` +
      `2. IGALANG ANG BAWAT KASAPI AT ANG ADMINISTRATOR\n` +
      `   - Iwasan ang paggamit ng mga hindi kaaya-ayang salita, pakikipag-away, o pagpapakalat ng maling impormasyon.\n\n` +
      `3. BAWAL ANG SPAM AT UNSOLICITED PROMOTION\n` +
      `   - Iwasan ang pagpapadala ng paulit-ulit na mensahe, nakakasirang links, o anumang uri ng hindi awtorisadong promotional material.\n\n` +
      `4. PAGSUNOD SA MGA DIREKTIBA NG SYSTEM\n` +
      `   - Ang lahat ng automated execution mula sa ating bot ay opisyal at ginawa para sa seguridad ng pangkat na ito.\n\n` +
      `Maraming salamat sa inyong patuloy na pagsuporta at pagtalima sa ating mga regulasyon!`,
      threadID
    );
  }

  // Command 4: Help / Menu / Tulong
  if (command === 'help' || command === 'tulong' || command === 'menu' || command === 'commands') {
    return api.sendMessage(
      `======================================================================\n` +
      `📋 KUMPLETONG TALAAN NG MGA UTOS AT KONTROL NG ADMINISTRATOR\n` +
      `======================================================================\n\n` +
      `Magandang araw sa iyo, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
      `Narito ang kumpleto at komprehensibong talaan ng mga utos na maaari mong ipadala sa ating system upang pamahalaan at protektahan ang Group Chat na ito:\n\n` +
      `🔹 1. "!setgname [Pangalan]"\n` +
      `   - Awtomatikong papalitan ang pangalan ng Group Chat at lalagyan ito ng permanenteng security lock upang hindi mabago ng ibang members.\n\n` +
      `🔹 2. "!setnick [Nickname]"\n` +
      `   - Awtomatikong papalitan ang nickname ng LAHAT ng kasalukuyang miyembro sa pangkat at i-la-lock ang mga ito.\n\n` +
      `🔹 3. "!rules" o "!alituntunin"\n` +
      `   - Magpapadala ng napakahabang listahan ng mga opisyal na alituntunin para sa lahat ng miyembro ng pangkat.\n\n` +
      `🔹 4. "status" o "kalagayan"\n` +
      `   - Magpapadala ng kumpletong diagnostic report tungkol sa server runtime, 3-second response delay queue, at active locks.\n\n` +
      `🔹 5. "info" o "impormasyon"\n` +
      `   - Ipapaliwanag nang buo ang teknikal na arkitektura at seguridad ng ating bot engine.\n\n` +
      `Mangyaring mag-type lamang ng alinman sa mga utos sa itaas upang simulan ang pagproseso ng system.`,
      threadID
    );
  }

  // Command 5: Status / Kalagayan
  if (command === 'status' || command === 'kalagayan') {
    return api.sendMessage(
      `======================================================================\n` +
      `📊 OPISYAL NA DIAGNOSTIC AT PERFORMANCE STATUS REPORT\n` +
      `======================================================================\n\n` +
      `📌 PANGUNAHING METRICS NG SYSTEM:\n` +
      `- Operational System Status: AKTIBO AT GUMAGANA (ONLINE & RUNNING)\n` +
      `- Verified Administrator Account ID: ${ADMIN_ID}\n` +
      `- Enforced Response Delay Queue: 3.0 Sekundo (3,000 Milliseconds)\n` +
      `- Internal Communication Gateway: MQTT Listener / Express Engine\n\n` +
      `📌 STATUS NG MGA SECURITY LOCKS:\n` +
      `- Nakalock na GC Name: ${lockedGCName[threadID] ? `"${lockedGCName[threadID]}"` : "Wala pang nakaset na lock"}\n` +
      `- Nakalock na Uniform Nickname: ${lockedNickname[threadID] ? `"${lockedNickname[threadID]}"` : "Wala pang nakaset na lock"}\n\n` +
      `📌 EVALUATION NG SEGURIDAD:\n` +
      `Ang lahat ng computational execution pipelines, webhook security filters, at memory allocation modules ay gumagana sa pinakamataas na antas ng kalidad at walang naitalang anumang error.`,
      threadID
    );
  }

  // Command 6: Info / Impormasyon
  if (command === 'info' || command === 'impormasyon') {
    return api.sendMessage(
      `======================================================================\n` +
      `ℹ️ TEKNIKAL NA IMPORMASYON SA BOT ARCHITECTURE AT SEGURIDAD\n` +
      `======================================================================\n\n` +
      `Ang Messenger Automation System na ito ay binuo gamit ang Node.js runtime environment upang magbigay ng mataas na antas ng proteksyon para sa iyong Group Chat.\n\n` +
      `📌 MGA PANGUNAHING ENGINE FEATURE:\n` +
      `1. Single-Admin Authorization Gate:\n` +
      `   - Lahat ng pumasok na mensahe mula sa ibang Facebook ID ay tahimik na binabale-wala upang maiwasan ang abuse at maling paggamit ng bot.\n\n` +
      `2. Enforced 3-Second Queue Buffer:\n` +
      `   - Bago magpadala ng anumang awtomatikong tugon, ang bot ay nagpapakita ng typing status sa loob ng 3000ms upang maiwasan ang flagging mula sa spam detection systems.\n\n` +
      `3. Automatic State Reversion Logic:\n` +
      `   - Nakatutok ang system sa mga event ng Group Chat tulad ng log:thread-name at log:user-nickname upang agad na ibalik sa nakalock na estado ang pangkat kapag may nagtatangkang magbago nito.`,
      threadID
    );
  }

  // Default Extended Fallback Response (Kapag nag-type ang Admin ng kahit anong salita)
  api.sendMessage(
    `======================================================================\n` +
    `🤖 AUTOMATED ADMINISTRATIVE MESSAGE ACKNOWLEDGMENT AND RECEIPT\n` +
    `======================================================================\n\n` +
    `Isang malugod at maalab na pagbati mula sa iyong nakatalagang Bot Control Engine, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
    `Ang iyong ipinadalang mensahe ay matagumpay na pumasok sa ating security verification gateway, naproseso sa ating 3-segundong queue delay, at nakatala na ngayon sa ating system memory.\n\n` +
    `📝 DETALYE NG NATANGGAP NA TRANSMISSION:\n` +
    `- Nilalaman ng Mensahe: "${input}"\n` +
    `- Kabuuang Haba (Character Count): ${input.length} na mga letra/simbolo\n` +
    `- Response Delay Execution Time: Exactly 3.0 Seconds (3000ms)\n` +
    `- Sender Permission Level: FULL ADMINISTRATOR ACCESS\n\n` +
    `💡 MGA MUNGKAHING SALITA AT GABAY SA PAG-SET:\n` +
    `• Upang i-lock at palitan ang pangalan ng GC: i-type ang "!setgname <Bagong Pangalan>"\n` +
    `• Upang i-lock at gawing pare-pareho ang nickname ng lahat: i-type ang "!setnick <Bagong Nickname>"\n` +
    `• Upang maipakita ang kumpletong menu at talaan ng utos: i-type ang "help"\n\n` +
    `Ang ating system ay nananatiling handa at nakatutok sa iyong mga susunod na direktiba!`,
    threadID
  );
}
