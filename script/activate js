  description: "Infinite global auto-roast with Dual Admin Locks, Render fix, 2s setnick delay, Auto React, and Name Guard.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/Ryuk on | off | status | setgname <name> | setnick <name>",
  cooldowns: 2
};

