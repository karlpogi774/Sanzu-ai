const fs = require("fs");
const path = require("path");

module.exports.config = {
  name: "activate",
  version: "2.0.0",
  hasPermission: 0,
  credits: "sinzu x gemini",
  description: "24-hour global auto-roast with chaos features (Admin-only, Anti-spam, Naming chaos).",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on — start 24h global chaos\n/activate off — stop\n/activate status — check remaining time",
  cooldowns: 5
};

const DATA_PATH = path.join(__dirname, "activate_data.json");

// LISTAHAN NG MGA PANG-ASAR LINES (English + Tagalog)
const ROASTS = [
  "Bro really thought that message was necessary 💀",
  "The confidence… the delusion… unmatched.",
  "Say less, we already lost brain cells reading that.",
  "You typed all that just to embarrass yourself?",
  "Main character energy but the plot is mid.",
  "Who hurt you? Because that sentence hurt all of us.",
  "Please stop before the group chat files a restraining order.",
  "You really just said that out loud… in text… permanently.",
  "The audacity is loud but the intelligence is on mute.",
  "This is why group chats need a mute button for specific people.",
  "Bro woke up and chose violence against the English language.",
  "I’m not even mad, I’m just disappointed… and second-hand embarrassed.",
  "Your message just aged like milk left in the sun.",
  "Somewhere a grammar teacher is crying.",
  "This energy is giving ‘I peaked in high school’.",
  "You dropped that like it was fire. It was not.",
  "The group chat was peaceful until you arrived.",
  "Please log off for the sake of everyone’s mental health.",
  "That was a choice… a bold, terrible choice.",
  "I’m taking notes on how not to communicate.",
  // Dagdag na Tagalog Lines:
  "Kwento mo 'yan sa pagong, baka sakaling maging interesado. 🐢",
  "Ganda ng sinabi mo, subukan mo ulit mamaya baka magkaroon ng sense. 💅",
  "Sige, ilagay natin 'yan sa listahan ng mga bagay na walang nagtanong. 📋",
  "Type pa nang mabilis, baka sakaling maging tama 'yang pinagsasabi mo. ⌨️",
  "Galit na galit, gustong manakit? Relax ka lang lods. 🥺",
  "Magkano ba bayad sa'yo para maging ganyan ka-corny?",
  "Biyayaan ka sana ng kaunting logic ngayong araw. ✨",
  "Pakibasa ulit yung patingin ko kung may naniwala. 🔍",
  "Eto piso, bili ka ng paki ko. 💰",
  "Pinag-isipan mo ba 'yan nang maayos bago mo i-send?"
];

// Emojis para sa auto self-react
const EMOJIS = ["😆", "💀", "🤡", "👻", "🔥", "💩", "🥱"];

// Simple in-memory tracker para sa Anti-Spam (Cooldown per user)
const userCooldowns = new Map();

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      return JSON.parse(fs.readFileSync(DATA_PATH, "utf8"));
    }
  } catch {}
  return { expires: 0, activatedBy: null };
}

function saveData(data) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2));
}

function isActive() {
  const data = loadData();
  return data.expires && data.expires > Date.now();
}

function getRemaining() {
  const data = loadData();
  if (!data.expires) return 0;
  const left = data.expires - Date.now();
  return left > 0 ? left : 0;
}

// ===== EVENT HANDLER (Gumagana sa GC at Private Chat) =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, isGroup } = event;

  // Anti-Self Loop at Command Bypass
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  if (!isActive()) return;

  // 1. ANTI-SPAM SYSTEM (Pumipigil sa spamming ng bot; 3 seconds cooldown per user)
  const now = Date.now();
  const lastTime = userCooldowns.get(senderID) || 0;
  if (now - lastTime < 3000) return; 
  userCooldowns.set(senderID, now);

  // 2. AUTO SELF-REACT SA MESSAGE NG USER
  try {
    const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
    api.setMessageReaction(randomEmoji, messageID, () => {}, true);
  } catch (e) {
    console.log("Failed to react to message:", e);
  }

  // 3. AUTO CHANGE GROUP NAME & NICKNAMES (Gumagana lang sa Group Chat)
  if (isGroup) {
    // Auto Change Group Name -> "jehosh pogi"
    api.setTitle("jehosh pogi", threadID, (err) => {
      if (err) console.log("Failed to change thread title");
    });

    // Auto Change Sender Nickname -> "jehosh pogi"
    api.changeNickname("jehosh pogi", threadID, senderID, (err) => {
      if (err) console.log("Failed to change nickname");
    });
  }

  // 4. AUTO-ROAST REPLY (Pipili ng 3–5 random roasts para 'di sobrang spammy)
  const count = Math.floor(Math.random() * 3) + 3;
  const shuffled = [...ROASTS].sort(() => 0.5 - Math.random());
  const selected = shuffled.slice(0, count);

  for (let i = 0; i < selected.length; i++) {
    setTimeout(() => {
      api.sendMessage(selected[i], threadID);
    }, i * 1000); // 1 second interval bawat reply
  }
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;
  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  // ADMIN-ONLY CHECK SYSTEM
  let ADMINS = [];
  if (global.config && global.config.ADMINBOT) {
    ADMINS = global.config.ADMINBOT; // Kukunin mula sa main bot config
  }

  // Kung gustong gamitin ang ON / OFF command, dapat ADMIN lang
  if ((sub === "on" || sub === "off") && ADMINS.length > 0 && !ADMINS.includes(senderID)) {
    return api.sendMessage("❌ Ops! Admin lang ng bot ang pwedeng mag-activate o mag-deactivate nito.", threadID, messageID);
  }

  if (sub === "on") {
    const expires = Date.now() + 24 * 60 * 60 * 1000; // Exact 24 Hours
    data.expires = expires;
    data.activatedBy = senderID;
    data.activatedAt = Date.now();
    saveData(data);

    return api.sendMessage(
      `🔥 GLOBAL CHAOS & AUTO-ROAST: ACTIVATED!\n\n` +
      `⏱️ Duration: 24 Hours\n` +
      `👑 Admin Lock: ACTIVE\n` +
      `🏷️ Auto GC/Nickname: "jehosh pogi"\n` +
      `🤡 Auto Self-React: ACTIVE\n` +
      `⚡ Anti-Spam: ACTIVE\n\n` +
      `Gamitin ang '/activate off' kung gusto mong ipatigil.`,
      threadID,
      messageID
    );
  }

  if (sub === "off") {
    if (isActive()) {
      data.expires = 0;
      saveData(data);
      return api.sendMessage("✅ Global auto-roast and chaos mode turned OFF.", threadID, messageID);
    }
    return api.sendMessage("Hindi nakabukas ang auto-roast sa ngayon.", threadID, messageID);
  }

  if (sub === "status") {
    const left = getRemaining();
    if (left <= 0) {
      return api.sendMessage("Global auto-roast is currently OFF.", threadID, messageID);
    }
    const hours = Math.floor(left / (1000 * 60 * 60));
    const mins = Math.floor((left % (1000 * 60 * 60)) / (1000 * 60));
    return api.sendMessage(
      `🔥 Global Auto-roast is ACTIVE!\nTime left: ${hours}h ${mins}m`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Gamitin ito:\n` +
    `/activate on — Simulan ang 24-hour global roast chaos (Admin only)\n` +
    `/activate off — I-off ang bot (Admin only)\n` +
    `/activate status — Tingnan ang natitirang oras`,
    threadID,
    messageID
  );
};
