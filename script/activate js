const fs = require("fs");
const path = require("path");

module.exports.config = {
  name: "activate",
  version: "3.0.0",
  hasPermission: 0,
  credits: "sinzu",
  description: "Infinite auto-roast with slow-motion anti-spam protection, custom line management, and mass renaming.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/activate on | off | status | add <text> | listlines | setnick | setgname",
  cooldowns: 5
};

const DATA_PATH = path.join(__dirname, "activate_data.json");

// Emojis for auto self-react
const REACT_EMOJIS = ["🔥", "💀", "🤣", "😆", "🤡", "👎"];

// Default English roasts
const DEFAULT_ROASTS = [
  "Bro really thought that message was necessary 💀",
  "The confidence… the delusion… unmatched.",
  "Say less, we already lost brain cells reading that.",
  "You typed all that just to embarrass yourself?",
  "Main character energy but the plot is mid.",
  "Who hurt you? Because that sentence hurt all of us.",
  "Please stop before the group chat files a restraining order.",
  "You really just said that out loud… in text… permanently.",
  "The audacity is loud but the intelligence is on mute.",
  "This is why group chats need a mute button for specific people.",
  "Bro woke up and chose violence against the English language.",
  "I’m not even mad, I’m just disappointed… and second-hand embarrassed.",
  "Your message just aged like milk left in the sun.",
  "Somewhere a grammar teacher is crying.",
  "This energy is giving ‘I peaked in high school’.",
  "You dropped that like it was fire. It was not.",
  "The group chat was peaceful until you arrived.",
  "Please log off for the sake of everyone’s mental health.",
  "That was a choice… a bold, terrible choice.",
  "I’m taking notes on how not to communicate."
];

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const parsed = JSON.parse(fs.readFileSync(DATA_PATH, "utf8"));
      if (!parsed.roasts || parsed.roasts.length === 0) {
        parsed.roasts = DEFAULT_ROASTS;
      }
      return parsed;
    }
  } catch {}
  return { active: false, activatedBy: null, roasts: DEFAULT_ROASTS };
}

function saveData(data) {
  fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2));
}

function isActive() {
  const data = loadData();
  return data.active === true;
}

// ===== SLOW-MOTION & ANTI-SPAM SYSTEM =====
// Tracks last response timestamp per thread to prevent rapid-fire triggers
const lastResponseTime = new Map();
const COOLDOWN_DELAY = 5000; // 5 Seconds delay (Slow Motion Mode)

// Helper function for artificial delay
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body } = event;

  // Ignore empty messages, command prefixes, and bot's own messages
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  if (!isActive()) return;

  const now = Date.now();
  const lastTime = lastResponseTime.get(threadID) || 0;

  // SLOW MOTION ANTI-RESTRICTION: Ignore messages sent within the cooldown window
  if (now - lastTime < COOLDOWN_DELAY) {
    return;
  }

  // Update timestamp immediately to lock other incoming triggers
  lastResponseTime.set(threadID, now);

  try {
    const data = loadData();
    const roastsList = data.roasts && data.roasts.length > 0 ? data.roasts : DEFAULT_ROASTS;

    // Pick 1 random line
    const randomRoast = roastsList[Math.floor(Math.random() * roastsList.length)];
    const randomEmoji = REACT_EMOJIS[Math.floor(Math.random() * REACT_EMOJIS.length)];

    // Human-like delay (Slow motion effect: Wait 1 to 2.5 seconds before replying)
    const typingDelay = Math.floor(Math.random() * 1500) + 1000;
    await sleep(typingDelay);

    api.sendMessage(randomRoast, threadID, async (err, info) => {
      if (!err && info && info.messageID) {
        // Human-like delay before reacting (800ms) to avoid bot detection rate limits
        await sleep(800);
        api.setMessageReaction(randomEmoji, info.messageID, (reactErr) => {
          if (reactErr) console.error("Self-react error:", reactErr);
        }, true);
      }
    });
  } catch (error) {
    console.error("Auto-reply error:", error);
  }
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;
  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  // Turn ON Infinite Duration
  if (sub === "on") {
    data.active = true;
    data.activatedBy = senderID;
    data.activatedAt = Date.now();
    saveData(data);

    return api.sendMessage(
      `🔥 GLOBAL AUTO-ROAST: ON\n\n` +
      `Duration: INFINITE ♾️\n` +
      `Anti-Spam Mode: SLOW MOTION (5s Cooldown)\n` +
      `Auto Self-React: ACTIVE\n\n` +
      `Use /activate off to stop.`,
      threadID,
      messageID
    );
  }

  // Turn OFF
  if (sub === "off") {
    data.active = false;
    saveData(data);
    return api.sendMessage("✅ Global auto-roast turned OFF.", threadID, messageID);
  }

  // Check Status
  if (sub === "status") {
    if (!data.active) {
      return api.sendMessage("Global auto-roast is currently OFF.", threadID, messageID);
    }
    const totalLines = (data.roasts || DEFAULT_ROASTS).length;
    return api.sendMessage(
      `🔥 Global Auto-roast is ACTIVE (INFINITE ♾️)\n` +
      `Anti-Spam: Slow Motion Enabled\n` +
      `Total Lines/Roasts: ${totalLines}`,
      threadID,
      messageID
    );
  }

  // Add Custom Lines
  if (sub === "add") {
    const customLine = args.slice(1).join(" ");
    if (!customLine) {
      return api.sendMessage("❌ Please provide a line to add.\nExample: /activate add Your message is mid.", threadID, messageID);
    }

    if (!data.roasts) data.roasts = DEFAULT_ROASTS;
    data.roasts.push(customLine);
    saveData(data);

    return api.sendMessage(`✅ Added new line:\n"${customLine}"`, threadID, messageID);
  }

  // List All Custom Lines
  if (sub === "listlines") {
    const list = data.roasts || DEFAULT_ROASTS;
    let msg = `📜 Total Lines Available (${list.length}):\n\n`;
    list.forEach((line, index) => {
      msg += `${index + 1}. ${line}\n`;
    });
    return api.sendMessage(msg, threadID, messageID);
  }

  // Change All Members' Nicknames
  if (sub === "setnick") {
    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs;

      api.sendMessage(`⏳ Changing nicknames of all ${participantIDs.length} members to "Jehosh Pogi"...`, threadID);

      for (const userID of participantIDs) {
        // Slow motion delay for API requests to prevent Facebook restriction
        await sleep(500);
        api.changeNickname("Jehosh Pogi", threadID, userID, (err) => {
          if (err) console.error(`Failed to change nickname for ${userID}:`, err);
        });
      }
      return api.sendMessage("✅ Successfully updated all members' nicknames to 'Jehosh Pogi'.", threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ Failed to update nicknames. Make sure the bot has admin permissions.", threadID, messageID);
    }
  }

  // Change Group Name
  if (sub === "setgname") {
    api.setTitle("Jehosh Pogi", threadID, (err) => {
      if (err) {
        return api.sendMessage("❌ Failed to change group name. Check bot permissions.", threadID, messageID);
      }
      return api.sendMessage("✅ Group name successfully changed to 'Jehosh Pogi'.", threadID, messageID);
    });
    return;
  }

  return api.sendMessage(
    `Usage:\n` +
    `/activate on — Start infinite auto-roast (Slow Motion Anti-Spam)\n` +
    `/activate off — Stop auto-roast\n` +
    `/activate status — Check status & line count\n` +
    `/activate add <text> — Add custom auto-reply line\n` +
    `/activate listlines — View all active reply lines\n` +
    `/activate setnick — Set all members' nicknames to 'Jehosh Pogi'\n` +
    `/activate setgname — Change GC name to 'Jehosh Pogi'`,
    threadID,
    messageID
  );
};
