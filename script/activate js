// Cooldown Tracker for Auto Reply (2 seconds delay per thread)
const threadLastReplyTime = new Map();
const COOLDOWN_DELAY = 2000; // 2 Seconds

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const content = fs.readFileSync(DATA_PATH, "utf8");
      return JSON.parse(content);
    }
  } catch (err) {
    console.error("[Data Load Error]:", err.message);
  }
  return {};
}

function saveData(data) {
  try {
    fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2), "utf8");
  } catch (err) {
    console.error("[Data Save Error]:", err.message);
  }
}

function isThreadActive(threadID) {
  const data = loadData();
  const tData = data[threadID];
  if (!tData) return false;
  return Boolean(tData.active);
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// HELPER FUNCTION PARA MAG-CHECK KUNG ADMIN ANG SENDER
function checkIsAdmin(senderID) {
  return ADMIN_UIDS.includes(String(senderID));
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;

  // STRICT GC CHECK: WAG GUMANA KUNG HINDI AKTIBO SA SPESIFIYONG GC NA ITO
  if (!isThreadActive(threadID)) return;

  const data = loadData();
  const tData = data[threadID] || {};
  const currentLockedGName = tData.lockedGName || DEFAULT_LOCKED_NAME;
  const currentLockedNick = tData.lockedNick || DEFAULT_LOCKED_NAME;

  // 1. AUTO SETGNAME LOCK (THIS GC ONLY)
  if (logMessageType === "log:thread-name") {
    const newName = logMessageData ? logMessageData.name : "";
    if (newName !== currentLockedGName) {
      api.setTitle(currentLockedGName, threadID, (err) => {
        if (!err) {
          api.sendMessage(`🚫 GC Name is locked! Reverting back to: "${currentLockedGName}"`, threadID);
        }
      });
    }
    return;
  }

  // 2. AUTO SETNICK LOCK (THIS GC ONLY)
  if (logMessageType === "log:user-nickname") {
    const changedUser = logMessageData ? logMessageData.participant_id : null;
    const newNick = logMessageData ? logMessageData.nickname : "";

    if (changedUser && newNick !== currentLockedNick) {
      await sleep(1000);
      api.changeNickname(currentLockedNick, threadID, changedUser, () => {});
    }
    return;
  }

  // Ignore bot's own messages and command invocations
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  // 3. 2 SECONDS AUTO REPLY COOLDOWN PER GC
  const now = Date.now();
  const lastThreadTime = threadLastReplyTime.get(threadID) || 0;

  if (now - lastThreadTime < COOLDOWN_DELAY) {
    return; // Wait for 2 seconds cooldown
  }
  threadLastReplyTime.set(threadID, now);

  // 4. AUTO REACT WITH DOG EMOJI (🐕)
  api.setMessageReaction(DOG_EMOJI, messageID, () => {}, true);

  // 5. AUTO REPLY ROAST
  const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
  await sleep(1000);

  api.sendMessage({
    body: randomRoast,
    mentions: [{ tag: `@${senderID}`, id: senderID }]
  }, threadID, messageID);
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;

  // CHECK KUNG DALAWA SA INI-ALLOW NA ADMIN UIDs ANG SENDER
  if (!checkIsAdmin(senderID)) {
    // Kapag hindi admin ang nag-command, automatic roast reply sa kanila
    const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
    return api.sendMessage(randomRoast, threadID, messageID);
  }

  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  if (!data[threadID]) {
    data[threadID] = {
      active: false,
      activatedBy: null,
      lockedGName: DEFAULT_LOCKED_NAME,
      lockedNick: DEFAULT_LOCKED_NAME
    };
  }

  const tData = data[threadID];

  // /activate on
  if (sub === "on") {
    tData.active = true;
    tData.activatedBy = senderID;
    tData.activatedAt = Date.now();
    saveData(data);

    return api.sendMessage(
      `🐕 INFINITE AUTO-ROAST & PROTECTION: ACTIVATED IN THIS GC\n\n` +
      `• Duration: INFINITE (Permanent until turned off)\n` +
      `• Locked GC Name: "${tData.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `• Locked Nickname: "${tData.lockedNick || DEFAULT_LOCKED_NAME}"\n` +
      `• Auto-Reply Cooldown: 2 Seconds\n` +
      `• Auto-Reaction: 🐕 Only\n` +
      `• Setnick Delay: 2 Seconds/User\n` +
      `• Status: STRICTLY FOCUSING ON THIS GC\n\n` +
      `Use /activate off to stop manually.`,
      threadID,
      messageID
    );
  }

  // /activate off
  if (sub === "off") {
    if (isThreadActive(threadID)) {
      tData.active = false;
      saveData(data);
      return api.sendMessage("✅ Auto-roast turned OFF in this GC.", threadID, messageID);
    }
    return api.sendMessage("Auto-roast is not currently active in this GC.", threadID, messageID);
  }

  // /activate setgname <name>
  if (sub === "setgname") {
    const newGName = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    tData.lockedGName = newGName;
    saveData(data);

    api.setTitle(newGName, threadID, (err) => {
      if (err) return api.sendMessage("❌ Failed to change GC Name.", threadID, messageID);
      return api.sendMessage(`🔒 GC Name locked and updated to: "${newGName}" for this GC`, threadID, messageID);
    });
    return;
  }

  // /activate setnick <name> (WITH 2 SECONDS SLOW DELAY PER USER)
  if (sub === "setnick") {
    const newNick = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    tData.lockedNick = newNick;
    saveData(data);

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs || [];

      api.sendMessage(`⏳ Locking all nicknames in this GC to: "${newNick}" (2s delay per user)...`, threadID);

      for (const uid of participantIDs) {
        await sleep(2000); // 2 Seconds Delay per user to avoid Facebook rate limits
        api.changeNickname(newNick, threadID, uid, () => {});
      }
      return api.sendMessage(`🔒 All nicknames locked to: "${newNick}" in this GC`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ Failed to set nicknames.", threadID, messageID);
    }
  }

  // /activate status
  if (sub === "status") {
    const active = isThreadActive(threadID);
    if (!active) {
      return api.sendMessage("Auto-roast is currently OFF in this GC.", threadID, messageID);
    }
    return api.sendMessage(
      `🐕 Infinite Auto-roast is ACTIVE in this GC\n\n` +
      `⏱️ Duration: Unlimited (Infinite)\n` +
      `📌 Locked GC Name: "${tData.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `📌 Locked Nickname: "${tData.lockedNick || DEFAULT_LOCKED_NAME}"`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Usage (Admin Only):\n` +
    `/activate on — Start INFINITE auto-roast in THIS GC\n` +
    `/activate off — Stop auto-roast in THIS GC\n` +
    `/activate setgname <name> — Lock GC Name\n` +
    `/activate setnick <name> — Lock All Nicknames (2s delay)\n` +
    `/activate status — Check status`,
    threadID,
    messageID
  );
};
