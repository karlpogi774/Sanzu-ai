/**
 * Facebook Messenger Group Chat Bot (Infinite Duration & Unrestricted Anti-Spam)
 * Admin ID: 61593892603402
 * Delay: 3 Seconds (Infinite Execution)
 */

const login = require('fca-project-origo');
const fs = require('fs');

// System Configurations
const ADMIN_ID = "61593892603402";
const RESPONSE_DELAY_MS = 3000; // 3 Seconds Delay

// State Storage for Group Protection (Locks)
let lockedGCName = {}; 
let lockedNickname = {}; 

// Load Facebook Credentials (AppState)
let appState;
try {
  appState = JSON.parse(fs.readFileSync('appstate.json', 'utf8'));
} catch (err) {
  console.error('[ERROR] Hindi mahanap ang appstate.json file. Paki-ilagay ang iyong Facebook AppState cookies.');
  process.exit(1);
}

login({ appState: appState }, (err, api) => {
  if (err) return console.error('[LOGIN ERROR]', err);

  // Configure Bot Options (Infinite Listener Engine)
  api.setOptions({
    listenEvents: true,
    selfListen: false,
    logLevel: "silent",
    autoMarkDelivery: false,
    autoMarkRead: false
  });

  console.log(`======================================================================`);
  console.log(` INFINTITE DURATION ENGINE IS ONLINE & RUNNING PERMANENTLY`);
  console.log(` ANTI-SPAM RESTRICTIONS: DISABLED (UNRESTRICTED REPLY PROCESS)`);
  console.log(` AUTHORIZED ADMIN ID: ${ADMIN_ID}`);
  console.log(` AUTO-REPLY DELAY: EXACTLY 3 SECONDS (3000 MS)`);
  console.log(`======================================================================`);

  // Infinite Event Loop Listener
  api.listenMqtt(async (err, event) => {
    if (err) {
      console.error('[MQTT ERROR] Reconnecting stream...', err);
      return; // Hindi titigil ang process kapag nagka-error sa network
    }

    const threadID = event.threadID;

    // -------------------------------------------------------------------
    // 1. EVENT HANDLER: Auto-Reset GC Name & Auto-Reset Nickname Locks
    // -------------------------------------------------------------------
    if (event.type === "event") {
      
      // Auto-Reset GC Name Lock
      if (event.logMessageType === "log:thread-name") {
        const newName = event.logMessageData.name;
        const authorID = event.author;

        if (lockedGCName[threadID] && newName !== lockedGCName[threadID] && authorID !== ADMIN_ID) {
          api.setTitle(lockedGCName[threadID], threadID, (err) => {
            if (!err) {
              api.sendMessage(
                `======================================================================\n` +
                `⚠️ AUTOMATED GC NAME PROTECTION RESTORATION\n` +
                `======================================================================\n\n` +
                `Isang hindi awtorisadong pagpapalit ng pangalan ng Group Chat ang naidetekto!\n\n` +
                `📌 PINALITANG PANGALAN: "${newName}"\n` +
                `📌 AUTOMATED RESTORATION EXECUTION:\n` +
                `Awtomatikong ibinalik ng ating bot ang opisyal na pangalan sa:\n` +
                `👉 "${lockedGCName[threadID]}"\n\n` +
                `Ang aming Administrator (${ADMIN_ID}) lamang ang may pahintulot na magbago ng pangalan ng pangkat na ito.`,
                threadID
              );
            }
          });
        }
      }

      // Auto-Reset Nickname Lock
      if (event.logMessageType === "log:user-nickname") {
        const targetID = event.logMessageData.participant_id;
        const authorID = event.author;
        const newNick = event.logMessageData.nickname;

        if (lockedNickname[threadID] && newNick !== lockedNickname[threadID] && authorID !== ADMIN_ID) {
          api.changeNickname(lockedNickname[threadID], threadID, targetID, (err) => {
            if (!err) {
              api.sendMessage(
                `======================================================================\n` +
                `⚠️ AUTOMATED UNIFORM NICKNAME RESTORATION\n` +
                `======================================================================\n\n` +
                `Isang hindi awtorisadong pagpapalit ng nickname ang naitala sa ating system logs!\n\n` +
                `📌 NICKNAME RESTORATION EXECUTION:\n` +
                `Ang lahat ng miyembro sa pangkat na ito ay awtomatikong ibinabalik sa opisyal na uniform nickname:\n` +
                `👉 "${lockedNickname[threadID]}"\n\n` +
                `Inilapat para sa kaayusan ng pangkat sa ilalim ng pamamahala ng Admin (${ADMIN_ID}).`,
                threadID
              );
            }
          });
        }
      }
      return;
    }

    // -------------------------------------------------------------------
    // 2. MESSAGE HANDLER: Admin Commands & Unrestricted 3-Sec Auto-Reply
    // -------------------------------------------------------------------
    if (event.type === "message" && event.body) {
      const senderID = event.senderID;
      const messageText = event.body.trim();

      // SECURITY LOCK: Ignorahin ang mensahe kapag hindi mula sa Admin ID
      if (senderID !== ADMIN_ID) {
        return; 
      }

      // 3-Second Delay with Typing Indicator (No Anti-Spam Filters)
      api.sendTypingIndicator(threadID, (err) => {
        setTimeout(() => {
          processAdminCommands(api, threadID, messageText);
        }, RESPONSE_DELAY_MS);
      });
    }
  });
});

// -------------------------------------------------------------------
// 3. ADMIN COMMAND PROCESSOR & VERBOSE AUTO-REPLY ENGINE
// -------------------------------------------------------------------
function processAdminCommands(api, threadID, input) {
  const args = input.split(' ');
  const command = args[0].toLowerCase();
  const content = args.slice(1).join(' ');

  // Command 1: !setgname [Pangalan]
  if (command === '!setgname' || command === '/setgname') {
    if (!content) {
      return api.sendMessage(
        `======================================================================\n` +
        `📖 GABAY SA PAG-EXECUTE NG COMMAND: !setgname\n` +
        `======================================================================\n\n` +
        `Magandang araw Administrator (${ADMIN_ID})!\n\n` +
        `📌 TAMANG ESTRUKTURA NG UTOS:\n` +
        `!setgname [Isulat Dito Ang Bagong Pangalan Ng GC]\n\n` +
        `💡 HALIMBAWA:\n` +
        `!setgname Opisyal Na Pangkat Ng Mga Administrador`,
        threadID
      );
    }

    lockedGCName[threadID] = content;
    api.setTitle(content, threadID, (err) => {
      if (err) return api.sendMessage(`[ERROR] Hindi ma-set ang GC Name: ${err.error}`, threadID);
      
      api.sendMessage(
        `======================================================================\n` +
        `📢 OPISYAL NA ANUNSYO: ANG PANGALAN NG GROUP CHAT AY NAISAYOS AT NAILOCK NA!\n` +
        `======================================================================\n\n` +
        `Ang ating opisyal na Administrator (${ADMIN_ID}) ay matagumpay na naglapat ng panibagong katawagan para sa ating Group Chat.\n\n` +
        `🏆 BAGONG OPISYAL NA PANGALAN NG PANGKAT:\n` +
        `👉 "${content}"\n\n` +
        `🛡️ STATUS NG PROTEKSYON:\n` +
        `Naka-lock nang permanente sa ating database memory. Ang anumang subok ng iba na palitan ito ay awtomatikong ibabalik ng bot.`,
        threadID
      );
    });
    return;
  }

  // Command 2: !setnick [Nickname]
  if (command === '!setnick' || command === '/setnick') {
    if (!content) {
      return api.sendMessage(
        `======================================================================\n` +
        `📖 GABAY SA PAG-EXECUTE NG COMMAND: !setnick\n` +
        `======================================================================\n\n` +
        `Magandang araw Administrator (${ADMIN_ID})!\n\n` +
        `📌 TAMANG ESTRUKTURA NG UTOS:\n` +
        `!setnick [Isulat Dito Ang Nickname Para Sa Lahat]\n\n` +
        `💡 HALIMBAWA:\n` +
        `!setnick Opisyal Na Miyembro`,
        threadID
      );
    }

    lockedNickname[threadID] = content;

    api.getThreadInfo(threadID, (err, info) => {
      if (err) return api.sendMessage(`[ERROR] Hindi makuha ang impormasyon ng pangkat: ${err.error}`, threadID);

      const participantIDs = info.participantIDs;
      participantIDs.forEach((pID) => {
        api.changeNickname(content, threadID, pID);
      });

      api.sendMessage(
        `======================================================================\n` +
        `📢 OPISYAL NA AUTOMATED NICKNAME SYNCHRONIZATION EXECUTION\n` +
        `======================================================================\n\n` +
        `Ipinag-uutos ng ating Administrator (${ADMIN_ID}) na ang LAHAT ng kasalukuyang miyembro sa Group Chat na ito ay papalitang muli ng kanilang mga opisyal na katawagan.\n\n` +
        `🏷️ UNIFORM NICKNAME NA ILINAPAT SA LAHAT:\n` +
        `👉 "${content}"\n\n` +
        `🛡️ AUTOMATED PROTECTION STATUS:\n` +
        `Naka-lock na ang nickname ng bawat isa. Awtomatikong ibabalik ng bot kapag may pinalitan ng sinuman.`,
        threadID
      );
    });
    return;
  }

  // Command 3: Help / Menu / Tulong
  if (command === 'help' || command === 'tulong' || command === 'menu' || command === 'commands') {
    return api.sendMessage(
      `======================================================================\n` +
      `📋 KUMPLETONG TALAAN NG MGA UTOS AT KONTROL NG ADMINISTRATOR\n` +
      `======================================================================\n\n` +
      `Malugod na pagbati sa iyo, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
      `Narito ang kumpletong talaan ng mga direktiba na maaari mong gamitin:\n\n` +
      `🔹 1. "!setgname [Pangalan]"\n` +
      `   - Awtomatikong papalitan ang pangalan ng Group Chat at lalagyan ito ng permanenteng security lock.\n\n` +
      `🔹 2. "!setnick [Nickname]"\n` +
      `   - Awtomatikong papalitan ang nickname ng LAHAT ng kasalukuyang miyembro at i-la-lock ang mga ito.\n\n` +
      `🔹 3. "status" o "kalagayan"\n` +
      `   - Magpapadala ng diagnostic report ukol sa infinite engine, delay queue, at active locks.\n\n` +
      `🔹 4. "info" o "impormasyon"\n` +
      `   - Ipapaliwanag ang teknikal na seguridad ng ating bot engine.`,
      threadID
    );
  }

  // Command 4: Status / Kalagayan
  if (command === 'status' || command === 'kalagayan') {
    return api.sendMessage(
      `======================================================================\n` +
      `📊 INFINITE BOT ENGINE DIAGNOSTIC REPORT\n` +
      `======================================================================\n\n` +
      `- Operational Status: INFINITE RUNTIME (WALANG KATAPUSAN / NON-STOP)\n` +
      `- Anti-Spam Restrictions: DISABLED (UNLIMITED RESPONSES)\n` +
      `- Verified Administrator Account ID: ${ADMIN_ID}\n` +
      `- Enforced Response Queue Delay: 3.0 Seconds (3000ms)\n\n` +
      `📌 CURRENT ACTIVE PROTECTION LOCKS:\n` +
      `- Nakalock na GC Name: ${lockedGCName[threadID] ? `"${lockedGCName[threadID]}"` : "Wala pang nakaset na lock"}\n` +
      `- Nakalock na Uniform Nickname: ${lockedNickname[threadID] ? `"${lockedNickname[threadID]}"` : "Wala pang nakaset na lock"}\n\n` +
      `Ang lahat ng background computational routines at MQTT listeners ay gumagana nang walang humpay.`,
      threadID
    );
  }

  // Default Verbose Fallback Response (Kapag nag-type ang Admin ng kahit anong salita)
  api.sendMessage(
    `======================================================================\n` +
    `🤖 UNRESTRICTED ADMINISTRATIVE AUTOMATED RESPONSE\n` +
    `======================================================================\n\n` +
    `Isang malugod na pagbati mula sa iyong nakatalagang Bot Control Engine, Kagalang-galang na Administrator (${ADMIN_ID})!\n\n` +
    `Ang iyong ipinadalang mensahe ay matagumpay na naiproseso matapos ang eksaktong 3-segundong antala (delay).\n\n` +
    `📝 DETALYE NG TRANSMISSION:\n` +
    `- Nilalaman ng Mensahe: "${input}"\n` +
    `- Haba ng Mensahe: ${input.length} na character/letra\n` +
    `- Runtime Duration Status: Infinite / Unrestricted Process\n` +
    `- Configured Response Delay: 3.0 Seconds\n\n` +
    `💡 MGA MUNGKAHING UTOS:\n` +
    `• Upang i-lock ang pangalan ng GC: "!setgname <Pangalan>"\n` +
    `• Upang i-lock ang nickname ng lahat: "!setnick <Nickname>"\n` +
    `• Upang maipakita ang talaan ng utos: "help"`,
    threadID
  );
}
