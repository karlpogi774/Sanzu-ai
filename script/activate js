module.exports.config = {
  name: "ryuk pogi",
  version: "3.5.0",
  hasPermission: 1, // Require Admin Permission Level
  credits: "sinzu & Gemini",
  description: "Infinite global auto-roast with Dual Admin Locks, Render fix, 2s setnick delay, Auto React, and Maangas Responses.",
  usePrefix: true,
  commandCategory: "Fun",
  usages: "/ryuk pogi on | off | status | setgname <name> | setnick <name>",
  cooldowns: 2
};

// ================= CONFIGURATION =================
// LISTAHAN NG MGA ADMIN UIDs (DALAWANG ACCOUNT MO)
