const threadLastReplyTime = new Map();
const COOLDOWN_DELAY = 2000;

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const content = fs.readFileSync(DATA_PATH, "utf8");
      return JSON.parse(content);
    }
  } catch (err) {
    console.error("[Data Load Error]:", err.message);
  }
  return { active: false, activatedBy: null, lockedGName: DEFAULT_LOCKED_NAME, lockedNick: DEFAULT_LOCKED_NAME };
}

function saveData(data) {
  try {
    fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2), "utf8");
  } catch (err) {
    console.error("[Data Save Error]:", err.message);
  }
}

function isActive() {
  const data = loadData();
  return Boolean(data.active);
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

function checkIsAdmin(senderID) {
  return ADMIN_UIDS.includes(String(senderID));
}

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;
  const data = loadData();

  if (!isActive()) return;

  const currentLockedGName = data.lockedGName || DEFAULT_LOCKED_NAME;
  const currentLockedNick = data.lockedNick || DEFAULT_LOCKED_NAME;

  // 1. AUTO SETGNAME LOCK
  if (logMessageType === "log:thread-name") {
    const newName = logMessageData ? logMessageData.name : "";
    if (newName !== currentLockedGName) {
      api.setTitle(currentLockedGName, threadID, (err) => {
        if (!err) {
          api.sendMessage(`🚫 WAG MO SUBUKANG PALITAN GC NAME! NAKA-LOCK KAY "${currentLockedGName}" ITO! 💀 💯 🤪`, threadID);
        }
      });
    }
    return;
  }

  // 2. AUTO SETNICK LOCK
  if (logMessageType === "log:user-nickname") {
    const changedUser = logMessageData ? logMessageData.participant_id : null;
    const newNick = logMessageData ? logMessageData.nickname : "";

    if (changedUser && newNick !== currentLockedNick) {
      await sleep(1000);
      api.changeNickname(currentLockedNick, threadID, changedUser, () => {});
    }
    return;
  }

  // Ignore bot's own messages and command invocations
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  // 3. 2 SECONDS AUTO REPLY COOLDOWN
  const now = Date.now();
  const lastThreadTime = threadLastReplyTime.get(threadID) || 0;

  if (now - lastThreadTime < COOLDOWN_DELAY) {
    return;
  }
  threadLastReplyTime.set(threadID, now);

  // 4. AUTO REACT
  const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
  api.setMessageReaction(randomEmoji, messageID, () => {}, true);

  // 5. AUTO REPLY ROAST
  const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
  await sleep(1000);

  api.sendMessage({
    body: randomRoast,
    mentions: [{ tag: `@${senderID}`, id: senderID }]
  }, threadID, messageID);
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;

  // CHECK KUNG DALAWA SA INI-ALLOW NA ADMIN UIDs ANG SENDER
  if (!checkIsAdmin(senderID)) {
    const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
    return api.sendMessage(`🔥 SUBAN MO PA MAG-COMMAND KAHIT HINDI KA ADMIN? ETING SA'YO:\n\n${randomRoast}`, threadID, messageID);
  }

  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  // /ryuk pogi on
  if (sub === "on") {
    data.active = true;
    data.activatedBy = senderID;
    data.activatedAt = Date.now();
    saveData(data);

    return api.sendMessage(
      `🔥 RYUK POGI MODE IS NOW LIVE & DOMINATING! 🔥\n\n` +
      `⚡ STATUS: INFINITE ACTIVE (WALANG MUKHANG SUSUKO, WALANG MATUTULOG)\n` +
      `👑 COMMANDER ID: ${senderID}\n` +
      `🔒 LOCKED GC NAME: "${data.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `🔒 LOCKED NICKNAME: "${data.lockedNick || DEFAULT_LOCKED_NAME}"\n` +
      `💥 AUTOMATIC REACTION & ROAST SYSTEM: 100% FULL SPEED 🤪 💯\n\n` +
      `SINO PIPALAG DITO HAH? LAHAT NG MAG-CHAT DUDURUGIN AT AASARIN NA 24/7! 😈⚡`,
      threadID,
      messageID
    );
  }

  // /ryuk pogi off
  if (sub === "off") {
    if (isActive()) {
      data.active = false;
      saveData(data);
      return api.sendMessage("❌ PINATAY MO ANG RYUK POGI MODE! TAHIMIK NA ULIT ANG MGA EPAL SA GC. 💤⚡", threadID, messageID);
    }
    return api.sendMessage("💀 HINDI PA MAN NAKASINDI ANG BOT BAGO MO PATAYIN, TULOG NGA MUNA SABI EH!", threadID, messageID);
  }

  // /ryuk pogi setgname <name>
  if (sub === "setgname") {
    const newGName = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    data.lockedGName = newGName;
    saveData(data);

    api.setTitle(newGName, threadID, (err) => {
      if (err) return api.sendMessage("❌ AYAW PUMAGITNA NG FACEBOOK API, MAANGAS DIN EH!", threadID, messageID);
      return api.sendMessage(`👑 AKO ANG NASUSUNOD DITO! NAKA-LOCK NA GC NAME SA: "${newGName}" 💯 🤪`, threadID, messageID);
    });
    return;
  }

  // /ryuk pogi setnick <name>
  if (sub === "setnick") {
    const newNick = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    data.lockedNick = newNick;
    saveData(data);

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs || [];

      api.sendMessage(`⏳ ISSUING AUTHORITATIVE COMMAND: LOCKING ALL NICKNAMES TO "${newNick}" (2s SAFE SPEED)... 💀⚡`, threadID);

      for (const uid of participantIDs) {
        await sleep(2000); // 2 Seconds Delay per user
        api.changeNickname(newNick, threadID, uid, () => {});
      }
      return api.sendMessage(`👑 LAHAT NG TAO DITO MAY PARUSA AT NAKA-NICKNAME NA KAY "${newNick}"! WALANG MAKAKALIGTAS! 💯 🤪`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ NAGKA-ERROR SA PAGSET NG NICKNAME, MAY LUMALAGANAP NA REBELDE!", threadID, messageID);
    }
  }

  // /ryuk pogi status
  if (sub === "status") {
    if (!isActive()) {
      return api.sendMessage("⚠️ RYUK POGI IS OFF. TULOG ANG HARING MAG-AASAR!", threadID, messageID);
    }
    return api.sendMessage(
      `⚡ RYUK POGI SYSTEM STATUS REPORT ⚡\n\n` +
      `🔥 STATE: ACTIVE & UNSTOPPABLE 24/7\n` +
      `⏱️ DURATION: LIFETIME / INFINITE\n` +
      `📌 GC NAME GUARD: "${data.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `📌 NICKNAME GUARD: "${data.lockedNick || DEFAULT_LOCKED_NAME}"\n\n` +
      `WALANG LUGAR ANG MAHIHINA AT EPAL DITO! 🤪 💯`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `🔥 RYUK POGI CONTROL PANEL (ADMIN ONLY) 🔥\n\n` +
    `👉 /ryuk pogi on — Sindi ang maangas na infinite auto-roast\n` +
    `👉 /ryuk pogi off — Patayin ang auto-roast mode\n` +
    `👉 /ryuk pogi setgname <name> — I-lock ang pangalan ng GC\n` +
    `👉 /ryuk pogi setnick <name> — I-lock ang nicknames ng lahat ng members (2s delay)\n` +
    `👉 /ryuk pogi status — Tignan ang bagsik ng bot status`,
    threadID,
    messageID
  );
};
