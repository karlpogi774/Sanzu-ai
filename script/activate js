// Cooldown Tracker for Auto Reply (2 seconds delay per thread)
const threadLastReplyTime = new Map();
const COOLDOWN_DELAY = 2000; // 2 Seconds

function loadData() {
  try {
    if (fs.existsSync(DATA_PATH)) {
      const content = fs.readFileSync(DATA_PATH, "utf8");
      return JSON.parse(content);
    }
  } catch (err) {
    console.error("[Data Load Error]:", err.message);
  }
  return { expires: 0, activatedBy: null, lockedGName: DEFAULT_LOCKED_NAME, lockedNick: DEFAULT_LOCKED_NAME };
}

function saveData(data) {
  try {
    fs.writeFileSync(DATA_PATH, JSON.stringify(data, null, 2), "utf8");
  } catch (err) {
    console.error("[Data Save Error]:", err.message);
  }
}

function isActive() {
  const data = loadData();
  return data.expires && data.expires > Date.now();
}

function getRemaining() {
  const data = loadData();
  if (!data.expires) return 0;
  const left = data.expires - Date.now();
  return left > 0 ? left : 0;
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// ===== EVENT HANDLER =====
module.exports.handleEvent = async function ({ api, event }) {
  const { threadID, senderID, body, messageID, logMessageType, logMessageData } = event;
  const data = loadData();

  if (!isActive()) return;

  const currentLockedGName = data.lockedGName || DEFAULT_LOCKED_NAME;
  const currentLockedNick = data.lockedNick || DEFAULT_LOCKED_NAME;

  // 1. AUTO SETGNAME LOCK
  if (logMessageType === "log:thread-name") {
    const newName = logMessageData ? logMessageData.name : "";
    if (newName !== currentLockedGName) {
      api.setTitle(currentLockedGName, threadID, (err) => {
        if (!err) {
          api.sendMessage(`🚫 GC Name is locked! Reverting back to: "${currentLockedGName}"`, threadID);
        }
      });
    }
    return;
  }

  // 2. AUTO SETNICK LOCK
  if (logMessageType === "log:user-nickname") {
    const changedUser = logMessageData ? logMessageData.participant_id : null;
    const newNick = logMessageData ? logMessageData.nickname : "";

    if (changedUser && newNick !== currentLockedNick) {
      await sleep(1000);
      api.changeNickname(currentLockedNick, threadID, changedUser, () => {});
    }
    return;
  }

  // Ignore bot's own messages and command invocations
  if (!body || body.startsWith("/") || senderID === api.getCurrentUserID()) return;

  // 3. 2 SECONDS AUTO REPLY COOLDOWN
  const now = Date.now();
  const lastThreadTime = threadLastReplyTime.get(threadID) || 0;

  if (now - lastThreadTime < COOLDOWN_DELAY) {
    return; // Wait for 2 seconds cooldown
  }
  threadLastReplyTime.set(threadID, now);

  // 4. AUTO REACT
  const randomEmoji = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
  api.setMessageReaction(randomEmoji, messageID, () => {}, true);

  // 5. AUTO REPLY ROAST
  const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
  await sleep(1000);

  api.sendMessage({
    body: randomRoast,
    mentions: [{ tag: `@${senderID}`, id: senderID }]
  }, threadID, messageID);
};

// ===== COMMAND HANDLER =====
module.exports.run = async function ({ api, event, args }) {
  const { threadID, messageID, senderID } = event;

  // STRICT ADMIN ONLY CHECK (Only UID: 61593892603402)
  if (String(senderID) !== ADMIN_UID) {
    // Kapag hindi admin ang nag-command, automatic roast reply sa kanila
    const randomRoast = ROASTS[Math.floor(Math.random() * ROASTS.length)];
    return api.sendMessage(randomRoast, threadID, messageID);
  }

  const sub = (args[0] || "").toLowerCase();
  const data = loadData();

  // /activate on
  if (sub === "on") {
    const expires = Date.now() + 24 * 60 * 60 * 1000; // 24 hours
    data.expires = expires;
    data.activatedBy = senderID;
    data.activatedAt = Date.now();
    saveData(data);

    return api.sendMessage(
      `🔥 GLOBAL AUTO-ROAST & PROTECTION: ACTIVATED\n\n` +
      `• Duration: 24 Hours\n` +
      `• Locked GC Name: "${data.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `• Locked Nickname: "${data.lockedNick || DEFAULT_LOCKED_NAME}"\n` +
      `• Auto-Reply Cooldown: 2 Seconds\n` +
      `• Setnick Delay: 2 Seconds/User\n` +
      `• Auto React & Reply: Enabled\n\n` +
      `Use /activate off to stop manually.`,
      threadID,
      messageID
    );
  }

  // /activate off
  if (sub === "off") {
    if (isActive()) {
      data.expires = 0;
      saveData(data);
      return api.sendMessage("✅ Global auto-roast turned OFF.", threadID, messageID);
    }
    return api.sendMessage("Auto-roast is not currently active.", threadID, messageID);
  }

  // /activate setgname <name>
  if (sub === "setgname") {
    const newGName = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    data.lockedGName = newGName;
    saveData(data);

    api.setTitle(newGName, threadID, (err) => {
      if (err) return api.sendMessage("❌ Failed to change GC Name.", threadID, messageID);
      return api.sendMessage(`🔒 GC Name locked and updated to: "${newGName}"`, threadID, messageID);
    });
    return;
  }

  // /activate setnick <name> (WITH 2 SECONDS SLOW DELAY PER USER)
  if (sub === "setnick") {
    const newNick = args.slice(1).join(" ") || DEFAULT_LOCKED_NAME;
    data.lockedNick = newNick;
    saveData(data);

    try {
      const threadInfo = await api.getThreadInfo(threadID);
      const participantIDs = threadInfo.participantIDs || [];

      api.sendMessage(`⏳ Locking all nicknames to: "${newNick}" (2s delay per user)...`, threadID);

      for (const uid of participantIDs) {
        await sleep(2000); // 2 Seconds Delay per user to avoid Facebook rate limits
        api.changeNickname(newNick, threadID, uid, () => {});
      }
      return api.sendMessage(`🔒 All nicknames locked to: "${newNick}"`, threadID, messageID);
    } catch (e) {
      return api.sendMessage("❌ Failed to set nicknames.", threadID, messageID);
    }
  }

  // /activate status
  if (sub === "status") {
    const left = getRemaining();
    if (left <= 0) {
      return api.sendMessage("Global auto-roast is currently OFF.", threadID, messageID);
    }
    const hours = Math.floor(left / (1000 * 60 * 60));
    const mins = Math.floor((left % (1000 * 60 * 60)) / (1000 * 60));
    return api.sendMessage(
      `🔥 Global Auto-roast is ACTIVE\n\n` +
      `⏱️ Time left: ${hours}h ${mins}m\n` +
      `📌 Locked GC Name: "${data.lockedGName || DEFAULT_LOCKED_NAME}"\n` +
      `📌 Locked Nickname: "${data.lockedNick || DEFAULT_LOCKED_NAME}"`,
      threadID,
      messageID
    );
  }

  return api.sendMessage(
    `Usage (Admin Only):\n` +
    `/activate on — Start 24h global auto-roast\n` +
    `/activate off — Stop auto-roast\n` +
    `/activate setgname <name> — Lock GC Name\n` +
    `/activate setnick <name> — Lock All Nicknames (2s delay)\n` +
    `/activate status — Check remaining time`,
    threadID,
    messageID
  );
};
